#!/bin/sh
# arctic-generation - the numbered system configurations arctic-rebuild leaves behind
#
#   arctic-generation list                 show every generation, newest first
#   arctic-generation create [description] record the system as it stands now
#   arctic-generation show [id]            what a generation contains
#   arctic-generation diff <a> [b]         what changed between two generations
#   arctic-generation switch <id>          make the system match a generation
#   arctic-generation delete <id>          remove one
#   arctic-generation prune [keep]         keep only the newest N (default 10)
#   arctic-generation current              print the current generation id
#
# A generation is a complete record of what the system was declared to be at
# one moment: system.conf, the explicit package set with exact versions, the
# enabled services, and which kernel was in use. Every arctic-rebuild writes
# one before it changes anything.
#
# This is what makes a bad edit recoverable. `arctic-generation switch 3`
# puts system.conf back to what generation 3 said and reconciles the machine
# to it, and the bootloader lists the recent ones so a configuration that
# will not boot can be escaped from the boot menu instead of a rescue USB.
#
# shellcheck shell=sh disable=SC2039

set -u
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

GENDIR=/var/lib/arctic/generations
CONF=/etc/arctic/system.conf

if [ -t 1 ]; then
	R=$(printf '\033[0m'); B=$(printf '\033[1m')
	TEAL=$(printf '\033[38;5;44m'); MINT=$(printf '\033[38;5;79m')
	AMB=$(printf '\033[38;5;215m'); GREY=$(printf '\033[38;5;245m')
	RED=$(printf '\033[38;5;203m')
else
	R= ; B= ; TEAL= ; MINT= ; AMB= ; GREY= ; RED=
fi
note() { printf '%s::%s %s\n' "$TEAL" "$R" "$*"; }
die()  { printf '%sarctic-generation:%s %s\n' "$RED" "$R" "$*" >&2; exit 1; }

need_root() { [ "$(id -u)" = 0 ] || die "must be run as root"; }

# ------------------------------------------------------------------- helpers

explicit_pkgs() {
	for d in /var/lib/alpm/local/*/; do
		[ -d "$d" ] || continue
		[ "$(cat "${d}REASON" 2>/dev/null)" = "explicit" ] || continue
		basename "$d"
	done | sort
}

# name<TAB>version-release, so a generation records exactly what was on the
# machine and not just which names were asked for.
explicit_pkgs_versioned() {
	for d in /var/lib/alpm/local/*/; do
		[ -d "$d" ] || continue
		[ "$(cat "${d}REASON" 2>/dev/null)" = "explicit" ] || continue
		n=$(basename "$d")
		v=$(awk -F' *= *' '$1=="version"{print $2}' "${d}PKGINFO" 2>/dev/null)
		r=$(awk -F' *= *' '$1=="release"{print $2}' "${d}PKGINFO" 2>/dev/null)
		printf '%s\t%s-%s\n' "$n" "${v:-?}" "${r:-1}"
	done | sort
}

enabled_services() {
	for f in /etc/arctic/services/*; do
		[ -e "$f" ] || continue
		basename "$f"
	done | sort
}

running_kernel() {
	k=$(ls /boot/vmlinuz-* 2>/dev/null | head -1)
	[ -n "$k" ] && basename "$k" || uname -r
}

# Generation ids are plain increasing integers - 1, 2, 3 - so the boot menu
# and `arctic rollback 3` can both talk about the same thing.
next_id() {
	max=0
	for d in "$GENDIR"/[0-9]*; do
		[ -d "$d" ] || continue
		n=$(basename "$d")
		case "$n" in *[!0-9]*) continue ;; esac
		[ "$n" -gt "$max" ] && max=$n
	done
	echo $((max + 1))
}

all_ids() {
	for d in "$GENDIR"/[0-9]*; do
		[ -d "$d" ] || continue
		n=$(basename "$d")
		case "$n" in *[!0-9]*) continue ;; esac
		echo "$n"
	done | sort -n
}

current_id() { cat "$GENDIR/current" 2>/dev/null; }

gen_exists() { [ -d "$GENDIR/$1" ]; }

# ------------------------------------------------------------------ commands

# Every variable here is underscore-prefixed on purpose. There is no `local`
# in POSIX sh, so a bare `id` or `d` set in here would overwrite the caller's
# - and cmd_switch calls this in the middle of its own work. That bug was
# real: `arctic-generation switch 1` recorded a pre-switch generation, had
# its own `id` and `d` replaced by the new one's, and then "rolled back" to
# the generation it had just created, leaving system.conf untouched.
cmd_create() {
	need_root
	_c_desc=${1:-manual}
	_c_id=$(next_id)
	_c_dir="$GENDIR/$_c_id"
	mkdir -p "$_c_dir" || die "cannot create $_c_dir"

	[ -f "$CONF" ] && cp -f "$CONF" "$_c_dir/system.conf" || : >"$_c_dir/system.conf"
	explicit_pkgs           >"$_c_dir/packages"
	explicit_pkgs_versioned >"$_c_dir/packages.versioned"
	enabled_services        >"$_c_dir/services"
	running_kernel          >"$_c_dir/kernel"
	date '+%Y-%m-%d %H:%M:%S' >"$_c_dir/date"
	printf '%s\n' "$_c_desc" >"$_c_dir/description"

	echo "$_c_id" >"$GENDIR/current"
	printf '%s\n' "$_c_id"
}

cmd_list() {
	[ -d "$GENDIR" ] || { note "no generations yet"; return 0; }
	cur=$(current_id)
	ids=$(all_ids)
	[ -n "$ids" ] || { note "no generations yet"; return 0; }
	printf '%s%-5s %-20s %-8s %-9s %s%s\n' "$B" "GEN" "DATE" "PACKAGES" "SERVICES" "DESCRIPTION" "$R"
	for id in $(printf '%s\n' "$ids" | sort -rn); do
		d="$GENDIR/$id"
		mark=" "
		[ "$id" = "$cur" ] && mark="*"
		printf '%s%-4s %-20s %-8s %-9s %s\n' \
			"$mark" "$id" \
			"$(cat "$d/date" 2>/dev/null)" \
			"$(wc -l <"$d/packages" 2>/dev/null | tr -d ' ')" \
			"$(wc -l <"$d/services" 2>/dev/null | tr -d ' ')" \
			"$(cat "$d/description" 2>/dev/null)"
	done
	printf '\n%s* = current%s\n' "$GREY" "$R"
}

cmd_show() {
	id=${1:-$(current_id)}
	[ -n "$id" ] || die "no generation given and no current one recorded"
	gen_exists "$id" || die "no such generation: $id"
	d="$GENDIR/$id"
	printf '%sgeneration %s%s\n' "$B" "$id" "$R"
	printf '  date        %s\n' "$(cat "$d/date" 2>/dev/null)"
	printf '  description %s\n' "$(cat "$d/description" 2>/dev/null)"
	printf '  kernel      %s\n' "$(cat "$d/kernel" 2>/dev/null)"
	printf '\n  packages (%s):\n' "$(wc -l <"$d/packages" | tr -d ' ')"
	sed 's/^/    /' "$d/packages" 2>/dev/null
	printf '\n  services (%s):\n' "$(wc -l <"$d/services" | tr -d ' ')"
	sed 's/^/    /' "$d/services" 2>/dev/null
}

cmd_diff() {
	a=${1:?usage: arctic-generation diff <a> [b]}
	b=${2:-$(current_id)}
	gen_exists "$a" || die "no such generation: $a"
	gen_exists "$b" || die "no such generation: $b"
	printf '%sgeneration %s -> %s%s\n\n' "$B" "$a" "$b" "$R"

	printf '%spackages%s\n' "$B" "$R"
	# comm needs sorted input, which both files already are.
	comm -13 "$GENDIR/$a/packages" "$GENDIR/$b/packages" | sed "s/^/  ${MINT}+${R} /"
	comm -23 "$GENDIR/$a/packages" "$GENDIR/$b/packages" | sed "s/^/  ${AMB}-${R} /"

	printf '\n%sservices%s\n' "$B" "$R"
	comm -13 "$GENDIR/$a/services" "$GENDIR/$b/services" | sed "s/^/  ${MINT}+${R} /"
	comm -23 "$GENDIR/$a/services" "$GENDIR/$b/services" | sed "s/^/  ${AMB}-${R} /"
	printf '\n'
}

cmd_switch() {
	need_root
	_s_id=${1:?usage: arctic-generation switch <id>}
	gen_exists "$_s_id" || die "no such generation: $_s_id"
	_s_dir="$GENDIR/$_s_id"

	# Record where we are first, so switching is itself undoable. Note the
	# underscore-prefixed names above: cmd_create sets its own variables and
	# would otherwise overwrite the target this is trying to switch to.
	if [ "$(current_id)" != "$_s_id" ]; then
		cmd_create "before switching to generation $_s_id" >/dev/null
	fi

	note "switching to generation $_s_id"
	cp -f "$_s_dir/system.conf" "$CONF" || die "could not restore system.conf"

	# arctic-rebuild does the actual reconciling - this only decides what
	# the system should be, exactly as if the file had been edited by hand.
	if command -v arctic-rebuild >/dev/null 2>&1; then
		ARCTIC_GEN_SWITCH=1 arctic-rebuild || \
			die "rebuild failed - system.conf is generation $_s_id, run arctic-rebuild to retry"
	fi
	echo "$_s_id" >"$GENDIR/current"
	command -v arctic-boot-generations >/dev/null 2>&1 && arctic-boot-generations || :
	note "now on generation $_s_id"
}

cmd_delete() {
	need_root
	id=${1:?usage: arctic-generation delete <id>}
	gen_exists "$id" || die "no such generation: $id"
	[ "$id" = "$(current_id)" ] && die "refusing to delete the current generation"
	rm -rf "$GENDIR/$id"
	note "deleted generation $id"
	command -v arctic-boot-generations >/dev/null 2>&1 && arctic-boot-generations || :
}

cmd_prune() {
	need_root
	keep=${1:-10}
	case "$keep" in *[!0-9]*|"") die "keep count must be a number" ;; esac
	cur=$(current_id)
	ids=$(all_ids | sort -rn)
	n=0
	for id in $ids; do
		n=$((n + 1))
		[ "$n" -le "$keep" ] && continue
		[ "$id" = "$cur" ] && continue
		rm -rf "$GENDIR/$id"
		printf '  removed generation %s\n' "$id"
	done
	command -v arctic-boot-generations >/dev/null 2>&1 && arctic-boot-generations || :
	note "kept the newest $keep"
}

mkdir -p "$GENDIR" 2>/dev/null || :

case "${1:-list}" in
list|ls)          shift 2>/dev/null; cmd_list ;;
create|new)       shift 2>/dev/null; cmd_create "$@" ;;
show|info)        shift 2>/dev/null; cmd_show "$@" ;;
diff)             shift 2>/dev/null; cmd_diff "$@" ;;
switch|rollback)  shift 2>/dev/null; cmd_switch "$@" ;;
delete|rm)        shift 2>/dev/null; cmd_delete "$@" ;;
prune)            shift 2>/dev/null; cmd_prune "$@" ;;
current)          current_id ;;
-h|--help|help)   sed -n '2,20p' "$0" | sed 's/^# \?//' ;;
*) die "unknown command: $1 (try --help)" ;;
esac
