# Arctic Linux - kernels repository
# Kernel flavours: Arctic-base-kernel, Arctic-libre-kernel, Arctic-small-kernel, and their headers.
# Kernel/firmware packages are too large for the free-tier pkg mirror - get
# them from the ISO itself or a GitHub release until they land here too.
name = kernels
url = https://pkg-arctic.apiwow.net/ALL/kernels
enabled = yes
priority = 15
