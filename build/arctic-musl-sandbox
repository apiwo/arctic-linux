#!/bin/sh
# arctic-musl-sandbox - arctic-sandbox, plus a working musl toolchain at
# /usr/musl inside the sandbox.
#
# WHY THIS EXISTS
#   musl-gcc's specs file bakes in absolute paths (/usr/musl/include,
#   /usr/musl/lib, ...) at musl's own configure time. Those paths only
#   resolve correctly if musl actually lives at /usr/musl wherever musl-gcc
#   runs. The build host is plain Gentoo and has no /usr/musl of its own, so
#   this script stages the real, already-built musl-*.alpmz package into a
#   scratch directory once and bind-mounts it to /usr/musl *inside* the
#   sandbox's own mount namespace - the host's actual filesystem is never
#   touched, so this is safe to rerun as often as needed.
#
#   Same rule as arctic-sandbox otherwise: the whole host is read-only,
#   only the build tree, source tree and /tmp are writable. Musl package
#   builds go through this instead of arctic-sandbox so CC=musl-gcc works
#   out of the box instead of every recipe hand-rolling a staging fallback.
#
# USAGE
#   arctic-musl-sandbox <command> [args...]
#   arctic-musl-sandbox --check              prove the musl toolchain works
#
#   ARCTIC_BUILD      writable build tree      (default /home/apiwo/arctic-build)
#   ARCTIC_TREE       writable source tree     (default /home/apiwo/arctic)
#   ARCTIC_MUSL_ROOT  staged musl root         (default $ARCTIC_BUILD/musl-root)
#   ARCTIC_MUSL_PKG   musl-*.alpmz to stage    (default: newest under $ARCTIC_BUILD/repo)
#
# Inside the sandbox: CC and MUSLGCC are both set to /usr/musl/bin/musl-gcc,
# and /usr/musl/bin is prepended to PATH.
#
# shellcheck shell=sh

set -u

: "${ARCTIC_BUILD:=/home/apiwo/arctic-build}"
: "${ARCTIC_TREE:=/home/apiwo/arctic}"
: "${ARCTIC_MUSL_ROOT:=$ARCTIC_BUILD/musl-root}"

HAVE_BWRAP=1
command -v bwrap >/dev/null 2>&1 || HAVE_BWRAP=0

if [ "$HAVE_BWRAP" = 0 ]; then
	if [ "${ARCTIC_UNSANDBOXED:-}" != "i-accept-the-risk" ]; then
		echo "arctic-musl-sandbox: bubblewrap (bwrap) is not installed" >&2
		echo "  without it a build can write to the host. Refusing to run unsandboxed." >&2
		echo "  Install bubblewrap, or if you accept the risk on this machine," >&2
		echo "  set ARCTIC_UNSANDBOXED=i-accept-the-risk." >&2
		exit 1
	fi
	echo "arctic-musl-sandbox: WARNING - no bubblewrap, running UNSANDBOXED" >&2
fi

find_musl_pkg() {
	[ -n "${ARCTIC_MUSL_PKG:-}" ] && { printf '%s\n' "$ARCTIC_MUSL_PKG"; return 0; }
	find "$ARCTIC_BUILD/repo" -maxdepth 3 -name 'musl-*.x86_64.alpmz' 2>/dev/null \
		| sort -V | tail -n1
}

stage_musl() {
	[ -x "$ARCTIC_MUSL_ROOT/usr/musl/bin/musl-gcc" ] && return 0
	pkg=$(find_musl_pkg)
	if [ -z "$pkg" ] || [ ! -f "$pkg" ]; then
		echo "arctic-musl-sandbox: no musl-*.alpmz found (looked under $ARCTIC_BUILD/repo)" >&2
		echo "  build/fetch the musl port first, or set ARCTIC_MUSL_PKG to its path." >&2
		exit 1
	fi
	echo "arctic-musl-sandbox: staging $pkg -> $ARCTIC_MUSL_ROOT" >&2
	rm -rf "$ARCTIC_MUSL_ROOT"
	mkdir -p "$ARCTIC_MUSL_ROOT"
	tar -xf "$pkg" -C "$ARCTIC_MUSL_ROOT" || {
		echo "arctic-musl-sandbox: failed to extract $pkg" >&2
		exit 1
	}
	# The package ships lib/ld-musl-x86_64.so.1 as a symlink to the
	# absolute path /usr/musl/lib/libc.so, which only resolves on a real
	# Arctic system. Replace it with a real copy so it's a self-contained
	# file usable as its own overlay layer below.
	rm -f "$ARCTIC_MUSL_ROOT/lib/ld-musl-x86_64.so.1"
	cp "$ARCTIC_MUSL_ROOT/usr/musl/lib/libc.so" "$ARCTIC_MUSL_ROOT/lib/ld-musl-x86_64.so.1"
}

mkdir -p "$ARCTIC_BUILD" "$ARCTIC_BUILD/tmp"
[ "$HAVE_BWRAP" = 1 ] && stage_musl

sandbox() {
	if [ "$HAVE_BWRAP" = 1 ]; then
		# Two paths need injecting that don't exist on the real host:
		#   /usr/musl                 musl's own install tree
		#   /usr/lib/ld-musl-x86_64.so.1  musl's hardcoded interpreter path,
		#     baked into every binary musl-gcc links. /lib is just a
		#     symlink to usr/lib on this host, and bind/tmpfs operations
		#     targeting a symlink path resolve through it and land on
		#     usr/lib directly - so the injection point really is
		#     /usr/lib, symlink or not.
		#
		# A plain --ro-bind can't add a new name to an existing read-only
		# directory (bwrap can't mkdir under something --ro-bind / /
		# already made read-only). --ro-overlay solves this properly: it
		# merges several source directories into one read-only view, with
		# no writable layer at all - so unlike a tmpfs-based workaround,
		# the result stays genuinely read-only for anything not already
		# present. A recipe that forgets DESTDIR and tries to write a
		# brand-new file into /usr/lib still fails closed, exactly like
		# plain arctic-sandbox.
		bwrap \
			--ro-bind / / \
			--overlay-src /usr --overlay-src "$ARCTIC_MUSL_ROOT/usr" --ro-overlay /usr \
			--overlay-src /usr/lib --overlay-src "$ARCTIC_MUSL_ROOT/lib" --ro-overlay /usr/lib \
			--dev /dev \
			--proc /proc \
			--tmpfs /run \
			--bind "$ARCTIC_BUILD" "$ARCTIC_BUILD" \
			--bind "$ARCTIC_TREE" "$ARCTIC_TREE" \
			--bind "$ARCTIC_BUILD/tmp" /tmp \
			--unshare-pid \
			--unshare-uts \
			--unshare-ipc \
			--die-with-parent \
			--new-session \
			--setenv TMPDIR /tmp \
			--setenv ARCTIC_SANDBOX 1 \
			--setenv ARCTIC_MUSL 1 \
			--setenv ARCTIC_BUILD "$ARCTIC_BUILD" \
			--setenv ARCTIC_TREE "$ARCTIC_TREE" \
			--setenv CC /usr/musl/bin/musl-gcc \
			--setenv MUSLGCC /usr/musl/bin/musl-gcc \
			--setenv PATH "/usr/musl/bin:${PATH:-/usr/bin:/bin}" \
			--chdir "$ARCTIC_BUILD" \
			"$@"
	else
		( cd "$ARCTIC_BUILD" && \
		  TMPDIR="$ARCTIC_BUILD/tmp" ARCTIC_SANDBOX=1 ARCTIC_MUSL=1 \
		  ARCTIC_BUILD="$ARCTIC_BUILD" ARCTIC_TREE="$ARCTIC_TREE" \
		  "$@" )
	fi
}

if [ "${1:-}" = "--check" ]; then
	if [ "$HAVE_BWRAP" = 0 ]; then
		printf 'no bubblewrap on this host - running ARCTIC_UNSANDBOXED, nothing to check.\n'
		exit 1
	fi
	printf 'checking that the musl sandbox actually holds...\n\n'
	fail=0

	printf '  %-46s' "host /usr/lib is read-only"
	if sandbox /bin/sh -c 'touch /usr/lib/.arctic-sandbox-probe 2>/dev/null'; then
		printf 'FAIL - it is writable\n'; fail=1
		rm -f /usr/lib/.arctic-sandbox-probe
	else
		printf 'ok\n'
	fi

	printf '  %-46s' "/usr/musl/bin/musl-gcc is present"
	if sandbox /bin/sh -c 'test -x /usr/musl/bin/musl-gcc'; then
		printf 'ok\n'
	else
		printf 'FAIL\n'; fail=1
	fi

	printf '  %-46s' "musl-gcc actually compiles + links + runs"
	out=$(sandbox /bin/sh -c '
		printf "int main(void){return 0;}\n" > "$TMPDIR/t.c" &&
		/usr/musl/bin/musl-gcc "$TMPDIR/t.c" -o "$TMPDIR/t" 2>&1 &&
		"$TMPDIR/t"
	' 2>&1)
	if [ "$?" = 0 ]; then
		printf 'ok\n'
	else
		printf 'FAIL - %s\n' "$out"; fail=1
	fi

	printf '\n'
	if [ "$fail" = 0 ]; then
		printf 'the musl sandbox holds and musl-gcc works.\n'
		exit 0
	fi
	printf 'the musl sandbox does NOT work correctly - do not build musl packages until fixed.\n'
	exit 1
fi

[ $# -gt 0 ] || { echo "usage: arctic-musl-sandbox <command> [args...]" >&2; exit 1; }
sandbox "$@"
