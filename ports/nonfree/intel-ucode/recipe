# intel-ucode - CPU microcode. Loaded by the bootloader before the kernel.
name=intel-ucode
version=20260610
release=1
desc="Microcode update image for Intel CPUs"
url="https://github.com/intel/Intel-Linux-Processor-Microcode-Data-Files"
license="Intel-proprietary-redistributable"
depend=""
source="intel-ucode-$version.tar.gz::https://github.com/intel/Intel-Linux-Processor-Microcode-Data-Files/archive/refs/tags/microcode-$version.tar.gz"
sha256="SKIP"
options="!strip"

package() {
	cd Intel-Linux-Processor-Microcode-Data-Files-microcode-$version
	install -d "$pkgdir/usr/lib/firmware/intel-ucode"
	install -Dm644 intel-ucode/* "$pkgdir/usr/lib/firmware/intel-ucode/"
	# The early-load image the bootloader hands to the kernel as a module.
	install -d "$pkgdir/boot"
	mkdir -p iucode/kernel/x86/microcode
	cat intel-ucode/* >iucode/kernel/x86/microcode/GenuineIntel.bin
	( cd iucode && find . | cpio -o -H newc ) >"$pkgdir/boot/intel-ucode.img"
}
