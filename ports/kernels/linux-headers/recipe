# linux-headers - the kernel's userspace API headers. glibc needs these.
name=linux-headers
version=7.1.3
release=1
desc="Kernel headers for userspace"
url="https://kernel.org/"
license="GPL-2.0-only WITH Linux-syscall-note"
depend=""
source="https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-$version.tar.xz"
sha256="SKIP"

package() {
	cd "linux-$version"
	make headers_install INSTALL_HDR_PATH="$pkgdir/usr"
	find "$pkgdir/usr/include" -name '.*' -delete
	rm -f "$pkgdir/usr/include/Makefile"
}
