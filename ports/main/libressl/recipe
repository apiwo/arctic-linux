# libressl - OpenBSD TLS, Arctic's default
# Generated from manifest.tsv by gen-ports.py. Edit the manifest, not this file,
# unless the package needs something the template cannot express - in which case
# drop a `recipe.local` beside it and it will be preserved.
name=libressl
version=4.2.0
release=1
desc="OpenBSD TLS, Arctic's default"
url="https://www.libressl.org/"
license="ISC Apache-2.0"
depend="glibc"
makedepend=""
source="https://ftp.openbsd.org/pub/OpenBSD/LibreSSL/libressl-4.2.0.tar.gz"
sha256="SKIP"

build() {
	cd "libressl-4.2.0"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "libressl-4.2.0"
	make DESTDIR="$pkgdir" install
}
