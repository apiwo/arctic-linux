# openssl - TLS toolkit, for software that insists on it
# Generated from manifest.tsv by gen-ports.py. Edit the manifest, not this file,
# unless the package needs something the template cannot express - in which case
# drop a `recipe.local` beside it and it will be preserved.
name=openssl
version=3.6.2
release=1
desc="TLS toolkit, for software that insists on it"
url="https://openssl.org/"
license="Apache-2.0"
depend="glibc"
makedepend="perl"
source="https://github.com/openssl/openssl/releases/download/openssl-3.6.2/openssl-3.6.2.tar.gz"
sha256="SKIP"

build() {
	cd "openssl-3.6.2"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "openssl-3.6.2"
	make DESTDIR="$pkgdir" install
}
