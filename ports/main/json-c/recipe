name=json-c
version=0.19
release=1
desc="JSON parsing library"
url="https://github.com/json-c/json-c"
license="MIT"
depend="glibc"
makedepend="cmake ninja"
source="https://github.com/json-c/json-c/archive/refs/tags/json-c-0.19-20260627.tar.gz"
sha256="SKIP"

build() {
	cmake -S "json-c-json-c-0.19-20260627" -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_SHARED_LIBS=ON
	ninja -C build -j"$JOBS"
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
