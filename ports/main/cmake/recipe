# cmake - Cross-platform build generator
# Generated from manifest.tsv by gen-ports.py. Edit the manifest, not this file,
# unless the package needs something the template cannot express - in which case
# drop a `recipe.local` beside it and it will be preserved.
name=cmake
version=4.2.1
release=1
desc="Cross-platform build generator"
url="https://cmake.org/"
license="BSD-3-Clause"
depend="glibc libressl curl expat zlib libarchive netbsd-curses"
makedepend=""
source="https://github.com/Kitware/CMake/releases/download/v4.2.1/cmake-4.2.1.tar.gz"
sha256="SKIP"

build() {
	cd "cmake-4.2.1"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "cmake-4.2.1"
	make DESTDIR="$pkgdir" install
}
