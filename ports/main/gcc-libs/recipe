# gcc-libs - libstdc++ and libgcc_s runtime only, required by the NVIDIA driver
# Generated from manifest.tsv by gen-ports.py. Edit the manifest, not this file,
# unless the package needs something the template cannot express - in which case
# drop a `recipe.local` beside it and it will be preserved.
name=gcc-libs
version=15.3.0
release=1
desc="libstdc++ and libgcc_s runtime only, required by the NVIDIA driver"
url="https://gcc.gnu.org/"
license="GPL-3.0-or-later WITH GCC-exception-3.1"
depend="glibc"
makedepend=""
source="https://ftp.gnu.org/gnu/gcc/gcc-15.3.0/gcc-15.3.0.tar.xz"
sha256="SKIP"

build() {
	cd "gcc-15.3.0"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "gcc-15.3.0"
	make DESTDIR="$pkgdir" install
}
