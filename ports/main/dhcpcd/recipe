# dhcpcd - DHCP client
# Generated from manifest.tsv by gen-ports.py. Edit the manifest, not this file,
# unless the package needs something the template cannot express - in which case
# drop a `recipe.local` beside it and it will be preserved.
name=dhcpcd
version=10.4.0
release=1
desc="DHCP client"
url="https://roy.marples.name/projects/dhcpcd"
license="BSD-2-Clause"
depend="glibc"
makedepend=""
source="https://github.com/NetworkConfiguration/dhcpcd/releases/download/v10.4.0/dhcpcd-10.4.0.tar.xz"
sha256="SKIP"

build() {
	cd "dhcpcd-10.4.0"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "dhcpcd-10.4.0"
	make DESTDIR="$pkgdir" install
}
