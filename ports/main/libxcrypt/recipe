name=libxcrypt
version=4.5.2
release=1
desc="crypt(), which glibc no longer provides"
url="https://github.com/besser82/libxcrypt"
license="LGPL-2.1-or-later"
depend="glibc"
makedepend=""
source="https://github.com/besser82/libxcrypt/releases/download/v4.5.2/libxcrypt-4.5.2.tar.xz"
sha256="SKIP"

build() {
	cd "libxcrypt-4.5.2"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "libxcrypt-4.5.2"
	make DESTDIR="$pkgdir" install
}
