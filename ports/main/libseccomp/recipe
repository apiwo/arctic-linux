name=libseccomp
version=2.6.0
release=1
desc="Syscall filtering library"
url="https://github.com/seccomp/libseccomp"
license="LGPL-2.1-only"
depend="glibc"
makedepend=""
source="https://github.com/seccomp/libseccomp/releases/download/v2.6.0/libseccomp-2.6.0.tar.gz"
sha256="SKIP"

build() {
	cd "libseccomp-2.6.0"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "libseccomp-2.6.0"
	make DESTDIR="$pkgdir" install
}
