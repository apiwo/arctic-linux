name=dosfstools
version=4.2
release=1
desc="FAT filesystem tools"
url="https://github.com/dosfstools/dosfstools"
license="GPL-3.0-or-later"
depend="glibc"
makedepend=""
source="https://github.com/dosfstools/dosfstools/releases/download/v4.2/dosfstools-4.2.tar.gz"
sha256="SKIP"

build() {
	cd "dosfstools-4.2"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "dosfstools-4.2"
	make DESTDIR="$pkgdir" install
}
