name=perl
version=5.42.1
release=1
desc="Perl, needed to build openssl and git"
url="https://perl.org/"
license="Artistic-1.0-Perl GPL-1.0-or-later"
depend="glibc zlib bzip2"
makedepend=""
source="https://www.cpan.org/src/5.0/perl-5.42.1.tar.xz"
sha256="SKIP"

build() {
	cd "perl-5.42.1"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "perl-5.42.1"
	make DESTDIR="$pkgdir" install
}
