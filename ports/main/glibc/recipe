# glibc - the C library. The only GNU component in an Arctic system.
#
# Note for anyone reading this expecting clang: glibc upstream requires GCC to
# build itself, so the Arctic build machines keep a GCC purely as a stage-0
# tool. Nothing GCC produces beyond glibc ends up in a package, and the shipped
# toolchain is clang/lld.
name=glibc
version=2.44
release=1
desc="The GNU C library"
url="https://www.gnu.org/software/libc/"
license="LGPL-2.1-or-later"
depend="linux-headers"
makedepend="gcc bison python"
source="https://ftp.gnu.org/gnu/glibc/glibc-$version.tar.xz"
sha256="SKIP"
options="!strip"

build() {
	mkdir -p build
	cd build
	# Arctic is merged-/usr: the loader and the former sbin tools live in /usr.
	cat >configparms <<-CFG
		slibdir=/usr/lib
		rtlddir=/usr/lib
		sbindir=/usr/bin
		rootsbindir=/usr/bin
	CFG
	../glibc-$version/configure \
		--prefix=/usr \
		--libdir=/usr/lib \
		--libexecdir=/usr/lib/glibc \
		--enable-kernel=5.15 \
		--enable-stack-protector=strong \
		--enable-bind-now \
		--disable-nscd \
		--disable-werror \
		--without-selinux
	make -j"$JOBS"
}

package() {
	cd build
	make DESTDIR="$pkgdir" install
	mkdir -p "$pkgdir/usr/lib/locale" "$pkgdir/etc"
	printf 'C.UTF-8 UTF-8\nen_US.UTF-8 UTF-8\n' >"$pkgdir/etc/locale.gen"
	printf '/usr/lib\n/usr/local/lib\n' >"$pkgdir/etc/ld.so.conf"
}
