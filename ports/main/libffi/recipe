name=libffi
version=3.5.2
release=1
desc="Foreign function interface"
url="https://sourceware.org/libffi/"
license="MIT"
depend="glibc"
makedepend=""
source="https://github.com/libffi/libffi/releases/download/v3.5.2/libffi-3.5.2.tar.gz"
sha256="SKIP"

build() {
	cd "libffi-3.5.2"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "libffi-3.5.2"
	make DESTDIR="$pkgdir" install
}
