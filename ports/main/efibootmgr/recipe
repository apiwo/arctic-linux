name=efibootmgr
version=18
release=1
desc="Edit UEFI boot entries"
url="https://github.com/rhboot/efibootmgr"
license="GPL-2.0-or-later"
depend="glibc efivar"
makedepend="meson ninja"
source="https://github.com/rhboot/efibootmgr/archive/refs/tags/18.tar.gz"
sha256="SKIP"

build() {
	cd "18"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	cd "18"
	DESTDIR="$pkgdir" ninja -C build install
}
