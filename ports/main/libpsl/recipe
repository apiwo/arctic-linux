depend="glibc"
makedepend="meson ninja"
source="https://github.com/rockdaboot/libpsl/releases/download/0.21.5/libpsl-0.21.5.tar.gz"
sha256="SKIP"

build() {
	cd "libpsl-0.21.5"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	cd "libpsl-0.21.5"
	DESTDIR="$pkgdir" ninja -C build install
}
