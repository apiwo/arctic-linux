name=kmod
version=34.2
release=1
desc="Kernel module tools"
url="https://git.kernel.org/pub/scm/utils/kernel/kmod/kmod.git"
license="LGPL-2.1-or-later"
depend="glibc zlib xz zstd"
makedepend=""
source="https://kernel.org/pub/linux/utils/kernel/kmod/kmod-34.2.tar.xz"
sha256="SKIP"

build() {
	cd "kmod-34.2"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "kmod-34.2"
	make DESTDIR="$pkgdir" install
}
