# pcre2 - Perl compatible regular expressions
# Generated from manifest.tsv by gen-ports.py. Edit the manifest, not this file,
# unless the package needs something the template cannot express - in which case
# drop a `recipe.local` beside it and it will be preserved.
name=pcre2
version=10.46
release=1
desc="Perl compatible regular expressions"
url="https://pcre2project.github.io/pcre2/"
license="BSD-3-Clause"
depend="glibc zlib bzip2"
makedepend=""
source="https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.46/pcre2-10.46.tar.bz2"
sha256="SKIP"

build() {
	cd "pcre2-10.46"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "pcre2-10.46"
	make DESTDIR="$pkgdir" install
}
