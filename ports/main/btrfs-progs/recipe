build() {
	cd "btrfs-progs-v6.19"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "btrfs-progs-v6.19"
	make DESTDIR="$pkgdir" install
}
