// Arctic Linux - niri, as shipped by the niri-dms profile.
// Neutral grey and white, JetBrainsMono, DankMaterialShell for the bar
// and notifications. Copied to ~/.config/niri/config.kdl for new users;
// edit freely, alpm will not overwrite it (it is a backup= file).

// niri config for apiwo, ported from ~/.config/sway/config

input {
    keyboard {
        xkb {
        }
        repeat-delay 250
        repeat-rate 40
    }

    touchpad {
        tap
        natural-scroll
        dwt
    }
}

output "DP-3" {
    // Exact mode string confirmed via `niri msg outputs` (ASUSTek VG279QM5A).
    mode "1920x1080@240.002"
    // Monitor reports VRR as unsupported over this connection (niri msg outputs
    // shows "Variable refresh rate: not supported"), so this is a harmless no-op
    // rather than actual adaptive sync. Left in case a driver/cable change fixes it.
    variable-refresh-rate
}

layout {
    gaps 10

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#dcdcdc"
        inactive-color "#303030"
    }

    border {
        off
    }

    shadow {
        on
        softness 26
        spread 0
        offset x=0 y=6
        color "#00000080"
    }

    struts {
    }
}

spawn-sh-at-startup "pgrep -x pipewire >/dev/null || pipewire &"
spawn-sh-at-startup "sleep 1; pgrep -x wireplumber >/dev/null || wireplumber &"
spawn-sh-at-startup "sleep 1; pgrep -x pipewire-pulse >/dev/null || pipewire-pulse &"
spawn-at-startup "dms" "run"
spawn-at-startup "xsettingsd"
spawn-at-startup "mako"
spawn-at-startup "xwayland-satellite"
spawn-at-startup "swaybg" "-o" "*" "-i" "~/Downloads/Wallpaper.png" "-m" "fill"
spawn-sh-at-startup "pgrep -f polkit-gnome-authentication-agent-1 || /usr/libexec/polkit-gnome-authentication-agent-1"
spawn-sh-at-startup "export XDG_CURRENT_DESKTOP=niri XDG_SESSION_TYPE=wayland; pgrep -f xdg-desktop-portal-gnome >/dev/null || /usr/libexec/xdg-desktop-portal-gnome &"
spawn-sh-at-startup "sleep 1; pgrep -f 'xdg-desktop-portal$' >/dev/null || /usr/libexec/xdg-desktop-portal &"
spawn-sh-at-startup "swayidle -w timeout 300 '~/.config/sway/scripts/lock.sh' timeout 600 'niri msg action power-off-monitors' resume 'niri msg action power-on-monitors' before-sleep '~/.config/sway/scripts/lock.sh'"

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 24
}

environment {
    XCURSOR_THEME "Bibata-Modern-Classic"
    XCURSOR_SIZE "24"
    // Force dark GTK theme for all clients (Nemo included) — belt-and-suspenders
    // alongside the gsettings/gtk-3.0 settings.ini dark-theme config, since Wayland
    // sessions without a running xsettings daemon don't always propagate that reliably.
    GTK_THEME "Adwaita-dark"
}

animations {
}

// Nemo opens floating by default, per apiwo's request.
window-rule {
    match app-id=r#"^nemo$"#
    open-floating true
    default-column-width { proportion 0.45; }
    geometry-corner-radius 12
    clip-to-geometry true
}

// Firefox picture-in-picture floats too (niri upstream default rule).
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // -- Launchers (ported from sway's $term/$launcher/$menu/$filemgr) --
    Mod+Return       hotkey-overlay-title="Open a Terminal: foot" { spawn "foot"; }
    Mod+D            hotkey-overlay-title="Run an Application: fuzzel" { spawn "fuzzel"; }
    Mod+Shift+D      { spawn-sh "bemenu-run -i -p '' --fn 'JetBrainsMono Nerd Font 11' --tb '#1c1c1c' --tf '#ededed' --fb '#1c1c1c' --ff '#cacaca' --nb '#1c1c1c' --nf '#8a8a8a' --ab '#1c1c1c' --af '#cacaca' --hb '#303030' --hf '#ffffff' --sb '#303030' --sf '#ffffff' --scb '#1c1c1c' --scf '#dcdcdc' --border 2 --bdr '#4a4a4a' --line-height 26"; }
    Mod+N            { spawn "nemo"; }
    Mod+E            { spawn "firefox"; }
    Mod+L            hotkey-overlay-title="Lock the Screen" { spawn "swaylock -f"; }

    Mod+Shift+Q      repeat=false { close-window; }
    Mod+Escape       { spawn "wlogout" "-b" "3" "-T" "300" "-B" "300"; }
    Mod+Shift+E      { spawn "wlogout" "-b" "3" "-T" "300" "-B" "300"; }
    Ctrl+Alt+Delete  { quit; }

    // -- Focus movement (j/k + arrows; H repurposed below for tiling, use Left/Right for column focus) --
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    // Note: Mod+L is reserved for lock (below) — same as it ended up behaving
    // in the sway config, where the later lock bind overrode "focus right".
    // Use Mod+Right for focus-right.

    // -- Move window/column (Mod+Shift+ in sway, kept the same here rather than niri's default Mod+Ctrl+) --
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+L     { move-column-right; }

    // -- Workspaces (sway: mod+1..0, mod+shift+1..0) --
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    Mod+Tab   { focus-workspace-previous; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }

    // -- Layout (closest niri equivalents to sway's tree-layout binds) --
    Mod+W          { toggle-column-tabbed-display; }
    // i3-style h/v tiling: H pops the window into its own column (normal
    // side-by-side tiling), V stacks it into the focused column (vertical tiling).
    Mod+H          { expel-window-from-column; }
    Mod+V          { consume-window-into-column; }
    // F maximizes the column (still tiled, other columns just scroll off);
    // Shift+F is true fullscreen (hides everything, single window).
    Mod+F          { maximize-column; }
    Mod+Shift+F    { fullscreen-window; }
    Mod+Shift+Space { toggle-window-floating; }
    Mod+Space       { switch-focus-between-floating-and-tiling; }
    Mod+R           { switch-preset-column-width; }
    Mod+Shift+R     { switch-preset-column-width-back; }

    // -- Screenshots (sway used grim+slurp+wl-copy; niri's built-in screenshot UI copies to clipboard too) --
    Print          { screenshot; }
    Mod+Print      { screenshot-screen; }
    Mod+Shift+S    { screenshot; }

    // -- Media / brightness (identical to sway) --
    XF86AudioRaiseVolume  allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute         allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "brightnessctl set 5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "brightnessctl set 5%-"; }

    Mod+Shift+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+P { power-off-monitors; }
}

include "dms/outputs.kdl"
include "dms/binds.kdl"

include "dms/cursor.kdl"
include "dms/layout.kdl"
