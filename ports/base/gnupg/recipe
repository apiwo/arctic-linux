name=gnupg
version=2.5.14
release=1
desc="Encryption and signing"
url="https://gnupg.org/"
license="GPL-3.0-or-later"
depend="glibc libgcrypt libassuan libksba npth zlib"
makedepend=""
source="https://gnupg.org/ftp/gcrypt/gnupg/gnupg-2.5.14.tar.bz2"
sha256="SKIP"

build() {
	cd "gnupg-2.5.14"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "gnupg-2.5.14"
	make DESTDIR="$pkgdir" install
}
