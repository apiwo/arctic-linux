name=wlogout
version=1.1.1
release=1
desc="Wayland logout menu"
url="https://github.com/ArtsyMacaw/wlogout"
license="MIT"
depend="gtk3 wayland"
makedepend="meson ninja"
source="https://github.com/ArtsyMacaw/wlogout/archive/refs/tags/1.1.1.tar.gz"
sha256="SKIP"

build() {
	cd "1.1.1"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	cd "1.1.1"
	DESTDIR="$pkgdir" ninja -C build install
}
