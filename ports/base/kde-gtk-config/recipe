name=kde-gtk-config
version=6.5.0
release=1
desc="Make GTK applications match Plasma"
url="https://kde.org/"
license="GPL-2.0-or-later"
depend="kf6 gtk3"
makedepend="cmake ninja"
source="https://download.kde.org/stable/plasma/6.5.0/kde-gtk-config-6.5.0.tar.xz"
sha256="SKIP"

build() {
	cmake -S "kde-gtk-config-6.5.0" -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_SHARED_LIBS=ON
	ninja -C build -j"$JOBS"
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
