name=graphene
version=1.10.8
release=1
desc="Thin type library for graphics"
url="https://ebassi.github.io/graphene/"
license="MIT"
depend="glib"
makedepend="meson ninja"
source="https://github.com/ebassi/graphene/releases/download/1.10.8/graphene-1.10.8.tar.xz"
sha256="SKIP"

build() {
	cd "graphene-1.10.8"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	cd "graphene-1.10.8"
	DESTDIR="$pkgdir" ninja -C build install
}
