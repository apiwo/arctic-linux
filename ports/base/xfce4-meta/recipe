# xfce4-meta - the traditional light desktop.
name=xfce4-meta
version=4.22
release=1
desc="Xfce desktop environment (meta package)"
url="https://xfce.org/"
license="GPL-2.0-or-later"
depend="xfwm4 xfce4-panel xfce4-session xfdesktop thunar \
	xfce4-settings xfce4-appfinder xfce4-terminal \
	xfconf garcon exo tumbler xorg-server xorg-xinit \
	xfce4-notifyd xfce4-screenshooter"
source=""
sha256=""

package() {
	install -d "$pkgdir/usr/share/arctic"
	printf 'xfce\n' >"$pkgdir/usr/share/arctic/desktop"
}
