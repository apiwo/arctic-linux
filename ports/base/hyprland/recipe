# hyprland - the tiling Wayland compositor, with animations.
name=hyprland
version=0.53.0
release=1
desc="Dynamic tiling Wayland compositor with eye candy"
url="https://hypr.land/"
license="BSD-3-Clause"
depend="glibc wayland mesa libinput libxkbcommon pixman \
	aquamarine hyprcursor hyprlang hyprutils hyprgraphics \
	xorg-xwayland pango cairo seatd"
makedepend="cmake ninja clang lld"
source="hyprland-$version.tar.gz::https://github.com/hyprwm/Hyprland/releases/download/v$version/source-v$version.tar.gz"
sha256="SKIP"

build() {
	cd hyprland-source
	cmake -S . -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release
	ninja -C build -j"$JOBS"
}

package() {
	cd hyprland-source
	DESTDIR="$pkgdir" ninja -C build install
	# A starting configuration with the Arctic palette and sane keybinds.
	mkdir -p "$(dirname $pkgdir/etc/xdg/hypr/hyprland.conf)"
cat >"$pkgdir/etc/xdg/hypr/hyprland.conf" <<-'CONF'
		# Arctic Linux defaults for Hyprland
		monitor=,preferred,auto,1

		$terminal = foot
		$menu = wofi --show drun

		exec-once = waybar
		exec-once = hyprpaper

		general {
		    gaps_in = 4
		    gaps_out = 8
		    border_size = 2
		    col.active_border = rgba(03dbbbee) rgba(7e32caee) 45deg
		    col.inactive_border = rgba(2a2a3aaa)
		    layout = dwindle
		}

		decoration {
		    rounding = 8
		    blur {
		        enabled = true
		        size = 6
		        passes = 2
		    }
		}

		animations {
		    enabled = true
		    bezier = arctic, 0.05, 0.9, 0.1, 1.0
		    animation = windows, 1, 5, arctic
		    animation = fade, 1, 7, default
		    animation = workspaces, 1, 5, arctic
		}

		$mod = SUPER
		bind = $mod, Return, exec, $terminal
		bind = $mod, D, exec, $menu
		bind = $mod, Q, killactive
		bind = $mod SHIFT, E, exit
		bind = $mod, F, fullscreen
		bind = $mod, left, movefocus, l
		bind = $mod, right, movefocus, r
		bind = $mod, up, movefocus, u
		bind = $mod, down, movefocus, d
CONF
chmod 644 "$pkgdir/etc/xdg/hypr/hyprland.conf"
}
