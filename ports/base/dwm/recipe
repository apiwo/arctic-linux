# dwm - the suckless dynamic window manager, on X11.
name=dwm
version=6.6
release=1
desc="Dynamic window manager for X"
url="https://dwm.suckless.org/"
license="MIT"
depend="glibc libx11 libxft libxinerama freetype fontconfig"
makedepend="bmake clang lld"
source="https://dl.suckless.org/dwm/dwm-$version.tar.gz
	config.h"
sha256="SKIP
	SKIP"

build() {
	cd "dwm-$version"
	cp ../config.h config.h
	make -j"$JOBS" PREFIX=/usr FREETYPEINC=/usr/include/freetype2
}

package() {
	cd "dwm-$version"
	make PREFIX=/usr DESTDIR="$pkgdir" install
	install -Dm644 config.h "$pkgdir/usr/share/dwm/config.h"
	mkdir -p "$(dirname $pkgdir/usr/share/xsessions/dwm.desktop)"
cat >"$pkgdir/usr/share/xsessions/dwm.desktop" <<-'DESK'
		[Desktop Entry]
		Name=dwm
		Comment=Dynamic window manager
		Exec=dwm
		Type=XSession
DESK
chmod 644 "$pkgdir/usr/share/xsessions/dwm.desktop"
}
