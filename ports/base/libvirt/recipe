# libvirt - Virtualisation management API
# Generated from manifest.tsv by gen-ports.py. Edit the manifest, not this file,
# unless the package needs something the template cannot express - in which case
# drop a `recipe.local` beside it and it will be preserved.
name=libvirt
version=12.0.0
release=1
desc="Virtualisation management API"
url="https://libvirt.org/"
license="LGPL-2.1-or-later"
depend="glibc glib libxml2 qemu dnsmasq libnl"
makedepend="meson ninja"
source="https://download.libvirt.org/libvirt-12.0.0.tar.xz"
sha256="SKIP"

build() {
	cd "libvirt-12.0.0"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	cd "libvirt-12.0.0"
	DESTDIR="$pkgdir" ninja -C build install
}
