name=libostree
version=2026.1
release=1
desc="Git-like filesystem trees"
url="https://ostreedev.github.io/ostree/"
license="LGPL-2.0-or-later"
depend="glib libressl curl fuse3 zlib"
makedepend=""
source="https://github.com/ostreedev/ostree/releases/download/v2026.1/libostree-2026.1.tar.xz"
sha256="SKIP"

build() {
	cd "libostree-2026.1"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "libostree-2026.1"
	make DESTDIR="$pkgdir" install
}
