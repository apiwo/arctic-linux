# qemu - Machine emulator and virtualiser
# Generated from manifest.tsv by gen-ports.py. Edit the manifest, not this file,
# unless the package needs something the template cannot express - in which case
# drop a `recipe.local` beside it and it will be preserved.
name=qemu
version=11.0.0
release=1
desc="Machine emulator and virtualiser"
url="https://qemu.org/"
license="GPL-2.0-only"
depend="glibc glib pixman mesa alsa-lib pipewire libusb zstd"
makedepend="python ninja meson"
source="https://download.qemu.org/qemu-11.0.0.tar.xz"
sha256="SKIP"

build() {
	cd "qemu-11.0.0"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "qemu-11.0.0"
	make DESTDIR="$pkgdir" install
}
