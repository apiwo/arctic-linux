# fish - Friendly interactive shell
# Generated from manifest.tsv by gen-ports.py. Edit the manifest, not this file,
# unless the package needs something the template cannot express - in which case
# drop a `recipe.local` beside it and it will be preserved.
name=fish
version=4.2.0
release=1
desc="Friendly interactive shell"
url="https://fishshell.com/"
license="GPL-2.0-only"
depend="glibc netbsd-curses pcre2"
makedepend="cmake ninja rust"
source="https://github.com/fish-shell/fish-shell/releases/download/4.2.0/fish-4.2.0.tar.xz"
sha256="SKIP"

build() {
	cmake -S "fish-4.2.0" -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_SHARED_LIBS=ON
	ninja -C build -j"$JOBS"
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
