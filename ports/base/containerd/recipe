# containerd - Container runtime
# Generated from manifest.tsv by gen-ports.py. Edit the manifest, not this file,
# unless the package needs something the template cannot express - in which case
# drop a `recipe.local` beside it and it will be preserved.
name=containerd
version=2.2.0
release=1
desc="Container runtime"
url="https://containerd.io/"
license="Apache-2.0"
depend="glibc runc"
makedepend="go"
source="https://github.com/containerd/containerd/archive/refs/tags/v2.2.0.tar.gz"
sha256="SKIP"

build() {
	cd "containerd-2.2.0"
	export CGO_CPPFLAGS="$CPPFLAGS" CGO_CFLAGS="$CFLAGS" CGO_LDFLAGS="$LDFLAGS"
	export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
	go build -o "containerd" .
}

package() {
	cd "containerd-2.2.0"
	install -Dm755 "containerd" "$pkgdir/usr/bin/containerd"
}
