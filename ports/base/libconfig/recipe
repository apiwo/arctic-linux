name=libconfig
version=1.8.1
release=1
desc="Structured configuration file library"
url="https://hyperrealm.github.io/libconfig/"
license="LGPL-2.1-or-later"
depend="glibc"
makedepend=""
source="https://github.com/hyperrealm/libconfig/releases/download/v1.8.1/libconfig-1.8.1.tar.gz"
sha256="SKIP"

build() {
	cd "libconfig-1.8.1"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "libconfig-1.8.1"
	make DESTDIR="$pkgdir" install
}
