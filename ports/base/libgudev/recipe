# libgudev - GObject bindings for libudev
# Generated from manifest.tsv by gen-ports.py. Edit the manifest, not this file,
# unless the package needs something the template cannot express - in which case
# drop a `recipe.local` beside it and it will be preserved.
name=libgudev
version=238
release=1
desc="GObject bindings for libudev"
url="https://gitlab.gnome.org/GNOME/libgudev"
license="LGPL-2.1-or-later"
depend="glib libudev-zero"
makedepend="meson ninja"
source="https://download.gnome.org/sources/libgudev/238/libgudev-238.tar.xz"
sha256="SKIP"

build() {
	cd "libgudev-238"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	cd "libgudev-238"
	DESTDIR="$pkgdir" ninja -C build install
}
