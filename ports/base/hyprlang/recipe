name=hyprlang
version=0.6.4
release=1
desc="Hyprland configuration language"
url="https://github.com/hyprwm/hyprlang"
license="LGPL-3.0-only"
depend="glibc hyprutils"
makedepend="cmake ninja"
source="https://github.com/hyprwm/hyprlang/archive/refs/tags/v0.6.4.tar.gz"
sha256="SKIP"

build() {
	cmake -S "hyprlang-0.6.4" -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_SHARED_LIBS=ON
