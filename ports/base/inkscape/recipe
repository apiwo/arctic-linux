release=1
desc="Vector graphics editor"
url="https://inkscape.org/"
license="GPL-3.0-or-later"
depend="gtk3 librsvg poppler lcms2 gsl double-conversion"
makedepend="cmake ninja"
source="https://inkscape.org/gallery/item/56343/inkscape-1.5.1.tar.xz"
