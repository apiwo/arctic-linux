name=kf6
version=6.20.0
release=1
desc="KDE Frameworks 6"
url="https://api.kde.org/frameworks/"
license="LGPL-2.1-or-later"
depend="qt6-base qt6-declarative"
makedepend="cmake ninja"
source="https://download.kde.org/stable/frameworks/6.20/kf6-6.20.0.tar.xz"
