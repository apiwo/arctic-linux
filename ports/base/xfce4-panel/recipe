name=xfce4-panel
version=4.22.0
release=1
desc="The Xfce panel"
url="https://xfce.org/"
license="GPL-2.0-or-later"
depend="gtk3 libxfce4ui garcon exo"
makedepend=""
source="https://archive.xfce.org/src/xfce/xfce4-panel/4.22/xfce4-panel-4.22.0.tar.bz2"
sha256="SKIP"

build() {
	cd "xfce4-panel-4.22.0"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "xfce4-panel-4.22.0"
	make DESTDIR="$pkgdir" install
}
