name=xfce4-screenshooter
version=1.11.1
release=1
desc="Xfce screenshot tool"
url="https://xfce.org/"
license="GPL-2.0-or-later"
depend="gtk3 libxfce4ui"
makedepend=""
source="https://archive.xfce.org/src/apps/xfce4-screenshooter/1.11/xfce4-screenshooter-1.11.1.tar.bz2"
sha256="SKIP"

build() {
	cd "xfce4-screenshooter-1.11.1"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "xfce4-screenshooter-1.11.1"
	make DESTDIR="$pkgdir" install
}
