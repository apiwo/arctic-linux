# wayland - Wayland core protocol
# Generated from manifest.tsv by gen-ports.py. Edit the manifest, not this file,
# unless the package needs something the template cannot express - in which case
# drop a `recipe.local` beside it and it will be preserved.
name=wayland
version=1.25.0
release=1
desc="Wayland core protocol"
url="https://wayland.freedesktop.org/"
license="MIT"
depend="glibc expat libffi"
makedepend="meson ninja"
source="https://gitlab.freedesktop.org/wayland/wayland/-/releases/1.25.0/downloads/wayland-1.25.0.tar.xz"
sha256="SKIP"

build() {
	cd "wayland-1.25.0"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	cd "wayland-1.25.0"
	DESTDIR="$pkgdir" ninja -C build install
}
