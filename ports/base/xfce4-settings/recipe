name=xfce4-settings
version=4.22.0
release=1
desc="Xfce settings manager"
url="https://xfce.org/"
license="GPL-2.0-or-later"
depend="gtk3 libxfce4ui libinput xorg-server"
makedepend=""
source="https://archive.xfce.org/src/xfce/xfce4-settings/4.22/xfce4-settings-4.22.0.tar.bz2"
sha256="SKIP"

build() {
	cd "xfce4-settings-4.22.0"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "xfce4-settings-4.22.0"
	make DESTDIR="$pkgdir" install
}
