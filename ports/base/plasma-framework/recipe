name=plasma-framework
version=6.20.0
release=1
desc="Plasma QML framework"
url="https://kde.org/"
license="LGPL-2.1-or-later"
depend="kf6 qt6-base"
makedepend="cmake ninja"
source="https://download.kde.org/stable/frameworks/6.20/plasma-framework-6.20.0.tar.xz"
sha256="SKIP"

build() {
	cmake -S "plasma-framework-6.20.0" -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_SHARED_LIBS=ON
	ninja -C build -j"$JOBS"
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
