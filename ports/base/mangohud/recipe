# mangohud - Vulkan and OpenGL overlay
# Generated from manifest.tsv by gen-ports.py. Edit the manifest, not this file,
# unless the package needs something the template cannot express - in which case
# drop a `recipe.local` beside it and it will be preserved.
name=mangohud
version=0.9.0
release=1
desc="Vulkan and OpenGL overlay"
url="https://github.com/flightlessmango/MangoHud"
license="MIT"
depend="vulkan-loader mesa dbus"
makedepend="meson ninja"
source="https://github.com/flightlessmango/MangoHud/releases/download/v0.9.0/MangoHud-v0.9.0-Source.tar.xz"
sha256="SKIP"

build() {
	cd "MangoHud-v0.9.0-Source"
	meson setup build \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--buildtype=release \
		--wrap-mode=nodownload \
		-Db_lto=true
	ninja -C build -j"$JOBS"
}

package() {
	cd "MangoHud-v0.9.0-Source"
	DESTDIR="$pkgdir" ninja -C build install
}
