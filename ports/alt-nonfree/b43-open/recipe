# b43-open - free firmware for Broadcom cards, instead of broadcom-wl.
name=b43-open
version=5.2
release=1
desc="Free openfwwf firmware for Broadcom b43 wireless cards"
url="http://netweb.ing.unibs.it/~openfwwf/"
license="GPL-2.0-only"
depend=""
provides="broadcom-alternative"
conflicts="broadcom-wl"
source="http://netweb.ing.unibs.it/~openfwwf/firmware/openfwwf-$version.tar.gz"
sha256="SKIP"

package() {
	cd "openfwwf-$version"
	install -d "$pkgdir/usr/lib/firmware/b43-open"
	install -Dm644 *.fw "$pkgdir/usr/lib/firmware/b43-open/"
	install -Dm644 ucode5.fw "$pkgdir/usr/lib/firmware/b43-open/ucode5.fw"
}
