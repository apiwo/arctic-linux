# glibc-32 - The C library, 32-bit
# Generated from manifest.tsv by gen-ports.py. Edit the manifest, not this file,
# unless the package needs something the template cannot express - in which case
# drop a `recipe.local` beside it and it will be preserved.
name=glibc-32
version=2.44
release=1
desc="The C library, 32-bit"
url="https://www.gnu.org/software/libc/"
license="LGPL-2.1-or-later"
depend="glibc"
makedepend="gcc"
source="https://ftp.gnu.org/gnu/glibc/glibc-2.44.tar.xz"
sha256="SKIP"

build() {
	cd "glibc-2.44"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "glibc-2.44"
	make DESTDIR="$pkgdir" install
}
