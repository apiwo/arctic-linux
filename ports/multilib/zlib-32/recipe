name=zlib-32
version=1.3.1
release=1
desc="Compression library, 32-bit"
url="https://zlib.net/"
license="Zlib"
depend="zlib glibc-32"
makedepend=""
source="https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz"
sha256="SKIP"

build() {
	cd "zlib-1.3.1"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "zlib-1.3.1"
	make DESTDIR="$pkgdir" install
}
