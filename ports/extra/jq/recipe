name=jq
version=1.8.1
release=1
desc="Command-line JSON processor"
url="https://jqlang.github.io/jq/"
license="MIT"
depend="glibc oniguruma"
makedepend=""
source="https://github.com/jqlang/jq/releases/download/jq-1.8.1/jq-1.8.1.tar.gz"
sha256="SKIP"

build() {
	cd "jq-1.8.1"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "jq-1.8.1"
	make DESTDIR="$pkgdir" install
}
