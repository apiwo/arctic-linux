name=electron
version=43.2.0
release=1
desc="Chromium application runtime"
url="https://electronjs.org/"
license="MIT"
depend="glibc mesa libx11 wayland nss alsa-lib"
makedepend=""
source="https://github.com/electron/electron/releases/download/v43.2.0/electron-v43.2.0-linux-x64.zip"
sha256="SKIP"

# Repackaged upstream build. Arctic prefers to compile from source, but a few
# things ship only as binaries; those live here with the licence stated plainly.
options="!strip"

package() {
	cd "electron-v43.2.0-linux-x64"
	install -d "$pkgdir/opt/electron"
	cp -a . "$pkgdir/opt/electron/"
	install -d "$pkgdir/usr/bin"
	ln -sf "/opt/electron/electron" "$pkgdir/usr/bin/electron"
}
