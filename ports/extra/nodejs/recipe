name=nodejs
version=26.3.0
release=1
desc="JavaScript runtime"
url="https://nodejs.org/"
license="MIT"
depend="glibc libuv zlib brotli c-ares nghttp2 libressl"
makedepend="python ninja"
source="https://nodejs.org/dist/v26.3.0/node-v26.3.0.tar.xz"
sha256="SKIP"

build() {
	cd "node-v26.3.0"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "node-v26.3.0"
	make DESTDIR="$pkgdir" install
}
