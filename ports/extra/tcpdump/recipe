name=tcpdump
version=4.99.6
release=1
desc="Command-line packet analyser"
url="https://www.tcpdump.org/"
license="BSD-3-Clause"
depend="glibc libpcap libressl"
makedepend=""
source="https://www.tcpdump.org/release/tcpdump-4.99.6.tar.gz"
sha256="SKIP"

build() {
	cd "tcpdump-4.99.6"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "tcpdump-4.99.6"
	make DESTDIR="$pkgdir" install
}
