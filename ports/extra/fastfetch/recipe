# fastfetch - system information, with the Arctic logo already configured.
name=fastfetch
version=2.55.0
release=1
desc="System information tool, configured with the Arctic logo"
url="https://github.com/fastfetch-cli/fastfetch"
license="MIT"
depend="glibc"
makedepend="cmake ninja clang lld"
source="fastfetch-$version.tar.gz::https://github.com/fastfetch-cli/fastfetch/archive/refs/tags/$version.tar.gz"
sha256="SKIP"

build() {
	cmake -S "fastfetch-$version" -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release \
		-DENABLE_SYSTEM_YYJSON=OFF
	ninja -C build -j"$JOBS"
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
	# Ship the Arctic mark as fastfetch's logo, plus a matching config.
	install -Dm644 /usr/share/arctic/ascii/arctic-logo.txt \
		"$pkgdir/usr/share/fastfetch/logos/arctic.txt"
	mkdir -p "$(dirname $pkgdir/etc/xdg/fastfetch/config.jsonc)"
cat >"$pkgdir/etc/xdg/fastfetch/config.jsonc" <<-'JSON'
		{
		  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
		  "logo": {
		    "source": "/usr/share/fastfetch/logos/arctic.txt",
		    "type": "file",
		    "color": { "1": "magenta", "2": "cyan" },
		    "padding": { "top": 1, "left": 2 }
		  },
		  "display": { "separator": "  " },
		  "modules": [
		    "title",
		    "separator",
		    { "type": "os", "key": "os      " },
		    { "type": "host", "key": "host    " },
		    { "type": "kernel", "key": "kernel  " },
		    { "type": "uptime", "key": "uptime  " },
		    { "type": "packages", "key": "packages" },
		    { "type": "shell", "key": "shell   " },
		    { "type": "wm", "key": "wm      " },
		    { "type": "terminal", "key": "terminal" },
		    { "type": "cpu", "key": "cpu     " },
		    { "type": "gpu", "key": "gpu     " },
		    { "type": "memory", "key": "memory  " },
		    { "type": "disk", "key": "disk    " },
		    "break",
		    "colors"
		  ]
		}
JSON
chmod 644 "$pkgdir/etc/xdg/fastfetch/config.jsonc"
}
