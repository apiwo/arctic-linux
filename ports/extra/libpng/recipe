name=libpng
version=1.6.51
release=1
desc="PNG reference library"
url="http://www.libpng.org/pub/png/libpng.html"
license="Libpng"
depend="glibc zlib"
makedepend=""
source="https://downloads.sourceforge.net/libpng/libpng-1.6.51.tar.xz"
sha256="SKIP"

build() {
	cd "libpng-1.6.51"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "libpng-1.6.51"
	make DESTDIR="$pkgdir" install
}
