name=msgpack-c
version=6.1.1
release=1
desc="MessagePack for C"
url="https://msgpack.org/"
license="BSL-1.0"
depend="glibc"
makedepend="cmake ninja"
source="https://github.com/msgpack/msgpack-c/releases/download/c-6.1.1/msgpack-c-6.1.1.tar.gz"
sha256="SKIP"

build() {
	cmake -S "msgpack-c-6.1.1" -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=Release \
		-DBUILD_SHARED_LIBS=ON
	ninja -C build -j"$JOBS"
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
}
