name=smartmontools
version=7.6
release=1
desc="Disk health monitoring"
url="https://smartmontools.org/"
license="GPL-2.0-or-later"
depend="glibc"
makedepend=""
source="https://downloads.sourceforge.net/smartmontools/smartmontools-7.6.tar.gz"
sha256="SKIP"

build() {
	cd "smartmontools-7.6"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "smartmontools-7.6"
	make DESTDIR="$pkgdir" install
}
