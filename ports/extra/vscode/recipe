# vscode - Visual Studio Code, built from the MIT-licensed source.
#
# This builds Code - OSS from source rather than repackaging Microsoft's binary,
# so there is no telemetry and no proprietary licence attached. The marketplace
# is pointed at Open VSX, which is what a from-source build is allowed to use.
name=vscode
version=1.108.0
release=1
desc="Visual Studio Code, built from source (Code - OSS)"
url="https://github.com/microsoft/vscode"
license="MIT"
depend="glibc electron nodejs libsecret libx11 libxkbfile"
makedepend="nodejs npm python clang lld"
source="vscode-$version.tar.gz::https://github.com/microsoft/vscode/archive/refs/tags/$version.tar.gz
	product.json"
sha256="SKIP
	SKIP"

build() {
	cd "vscode-$version"
	# Point extensions at Open VSX; the Microsoft marketplace is not licensed
	# for third-party builds.
	cp ../product.json product.json
	npm ci
	npm run gulp vscode-linux-x64-min
}

package() {
	install -d "$pkgdir/usr/lib/vscode"
	cp -a VSCode-linux-x64/. "$pkgdir/usr/lib/vscode/"
	mkdir -p "$(dirname $pkgdir/usr/bin/code)"
cat >"$pkgdir/usr/bin/code" <<-'SH'
		#!/bin/sh
		exec electron /usr/lib/vscode/resources/app --ozone-platform-hint=auto "$@"
SH
chmod 755 "$pkgdir/usr/bin/code"
	mkdir -p "$(dirname $pkgdir/usr/share/applications/code.desktop)"
cat >"$pkgdir/usr/share/applications/code.desktop" <<-'DESK'
		[Desktop Entry]
		Name=Visual Studio Code
		Comment=Code editing. Redefined.
		Exec=code %F
		Icon=vscode
		Type=Application
		Categories=Development;IDE;
		StartupWMClass=Code
DESK
chmod 644 "$pkgdir/usr/share/applications/code.desktop"
}
