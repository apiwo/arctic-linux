name=ltrace
version=0.7.91
release=1
desc="Trace library calls"
url="https://ltrace.org/"
license="GPL-2.0-or-later"
depend="glibc libelf"
makedepend=""
source="https://gitlab.com/cespedes/ltrace/-/archive/0.7.91/ltrace-0.7.91.tar.gz"
sha256="SKIP"

build() {
	cd "ltrace-0.7.91"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "ltrace-0.7.91"
	make DESTDIR="$pkgdir" install
}
