name=xdg-utils
version=1.2.1
release=1
desc="Desktop integration helpers"
url="https://www.freedesktop.org/wiki/Software/xdg-utils/"
license="MIT"
depend="glibc"
makedepend=""
source="https://portland.freedesktop.org/download/xdg-utils-1.2.1.tar.gz"
sha256="SKIP"

build() {
	cd "xdg-utils-1.2.1"
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--localstatedir=/var \
		--libdir=/usr/lib \
		--disable-static \
		--disable-nls
	make -j"$JOBS"
}

package() {
	cd "xdg-utils-1.2.1"
	make DESTDIR="$pkgdir" install
}
