#!/bin/sh
# arctic-conf - configure an Arctic Linux install through menus
#
#   arctic-conf /mnt              walk through every question, then save
#   arctic-conf -o file /mnt      save the answers to a specific file
#
# This only asks questions, partitions/formats the disk if you ask it to, and
# writes an answer file. It does not install anything. That is arctic-strap's
# job:
#
#   mount /dev/nvme0n1p1 /mnt
#   arctic-conf /mnt
#   arctic-strap /mnt
#
# shellcheck shell=sh disable=SC2039,SC2059

set -u

LIB=/usr/lib/arctic
for d in "$LIB" "$(dirname "$0")/lib" ./lib; do
	[ -f "$d/tui.sh" ] && { . "$d/tui.sh"; TUILIB=$d; break; }
done
[ -n "${c_teal:-}" ] || { echo "arctic-conf: cannot find tui.sh" >&2; exit 1; }

for d in /usr/lib/alpm "$(dirname "$0")/../alpm" ./alpm; do
	[ -f "$d/libalpm.sh" ] && { . "$d/libalpm.sh"; break; }
done

VERSION="1.0.0"
CONF=/tmp/arctic-strap.conf

# ------------------------------------------------------------------- defaults
TARGET=""
A_PROFILE="minimal"
A_DESKTOP="none"
A_KERNEL="Arctic-base-kernel"
A_HOSTNAME="arctic"
A_USER=""
A_USERPASS=""
A_ROOTPASS=""
A_SHELL="/bin/zsh"
A_LOCALE="en_US.UTF-8"
A_LANG="en_US.UTF-8"
A_KEYMAP="us"
A_TZ="UTC"
A_NET="dhcp"
A_WIFI_SSID=""
A_WIFI_PSK=""
A_WIFI_IFACE=""
A_SWAP="none"
A_SWAPSIZE="4G"
A_SWAPDEV=""
A_GPU="auto"
A_AUDIO="yes"
A_BLUETOOTH="no"
A_SSH="no"
A_FIREWALL="yes"
A_NTP="yes"
A_TRIM="auto"
A_EXTRA=""
A_FS="ext4"
A_SNAPSHOT="timeshift"
A_BTRFS_OPTS=""
A_DISK_READY=""
A_ESP=""
A_ROOTDEV=""

LOGF=/tmp/arctic-conf.log
bail() { tui_done 2>/dev/null; printf '\033[38;5;203merror:\033[0m %s\n' "$*" >&2; exit 1; }
logit() { printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*" >>"$LOGF"; }

# ------------------------------------------------------------------ detection

detect_gpu() {
	if [ -d /sys/bus/pci/devices ]; then
		v=$(lspci 2>/dev/null | grep -iE 'vga|3d|display')
		case "$v" in
		*NVIDIA*|*nVidia*) echo nvidia ;;
		*AMD*|*ATI*|*"Advanced Micro"*) echo amd ;;
		*Intel*) echo intel ;;
		*) echo generic ;;
		esac
	else
		echo generic
	fi
}

detect_firmware() {
	[ -d /sys/firmware/efi ] && echo efi || echo bios
}

detect_existing_install() {
	[ -f "$1/etc/arctic-release" ]
}

list_timezones() {
	if [ -d /usr/share/zoneinfo ]; then
		( cd /usr/share/zoneinfo && find . -type f 2>/dev/null | \
			sed 's|^\./||' | grep -E '^[A-Z][a-z]+/' | sort | head -400 )
	else
		printf 'UTC\nEurope/London\nAmerica/New_York\nAmerica/Chicago\n'
		printf 'America/Denver\nAmerica/Los_Angeles\nEurope/Berlin\nAsia/Tokyo\n'
	fi
}

# ------------------------------------------------------------ network handling

net_interfaces() {
	for i in /sys/class/net/*; do
		n=$(basename "$i")
		[ "$n" = "lo" ] && continue
		printf '%s\n' "$n"
	done
}

net_is_wireless() { [ -d "/sys/class/net/$1/wireless" ]; }

net_online() {
	# Two shots at a well-known host; busybox ping has no -W on old builds.
	ping -c1 -w3 1.1.1.1 >/dev/null 2>&1 && return 0
	ping -c1 -w3 9.9.9.9 >/dev/null 2>&1
}

screen_network() {
	while :; do
		st="offline"
		net_online && st="online"
		tui_menu "Network configuration" "status: $st" \
			"dhcp|Wired (DHCP)|Bring up an ethernet link automatically" \
			"wifi|Wireless (iwctl)|Scan and join a wireless network" \
			"static|Static address|Set the address, gateway and DNS by hand" \
			"skip|Continue offline|Install from the ISO only, no repositories" \
			"test|Test the connection|Check whether the network is reachable now" \
		|| return 1
		case "$TUI_CHOICE" in
		dhcp)
			ifs=$(net_interfaces | while read -r i; do net_is_wireless "$i" || echo "$i"; done)
			[ -n "$ifs" ] || { tui_msgbox "Network" "No wired interface was found."; continue; }
			set -- $ifs
			iface=$1
			A_NET=dhcp
			tui_msgbox "Network" "Requesting an address on $iface."
			( ip link set "$iface" up 2>/dev/null
			  udhcpc -i "$iface" -n -q -s /usr/share/udhcpc/default.script >/dev/null 2>&1 \
			  	|| dhcpcd "$iface" >/dev/null 2>&1 ) &
			wait
			if net_online; then
				tui_msgbox "Network" "Online via $iface."
				return 0
			fi
			tui_msgbox "Network" "Could not get an address on $iface. Try wireless or static."
			;;
		wifi)
			screen_wifi && return 0
			;;
		static)
			tui_input "Network" "Interface name" "$(net_interfaces | head -1)" || continue
			iface=$TUI_VALUE
			tui_input "Network" "Address with prefix, e.g. 192.168.1.50/24" "" || continue
			addr=$TUI_VALUE
			tui_input "Network" "Gateway" "" || continue
			gw=$TUI_VALUE
			tui_input "Network" "DNS server" "1.1.1.1" || continue
			dns=$TUI_VALUE
			ip addr add "$addr" dev "$iface" 2>/dev/null
			ip link set "$iface" up 2>/dev/null
			ip route add default via "$gw" 2>/dev/null
			printf 'nameserver %s\n' "$dns" >/etc/resolv.conf
			A_NET="static:$iface:$addr:$gw:$dns"
			net_online && { tui_msgbox "Network" "Online."; return 0; }
			tui_msgbox "Network" "Still offline. Check the values and try again."
			;;
		skip)
			A_NET=offline
			return 0 ;;
		test)
			if net_online; then tui_msgbox "Network" "The network is up."
			else tui_msgbox "Network" "No route to the internet yet."; fi ;;
		esac
	done
}

screen_wifi() {
	wifs=$(net_interfaces | while read -r i; do net_is_wireless "$i" && echo "$i"; done)
	[ -n "$wifs" ] || { tui_msgbox "Wireless" "No wireless interface was found."; return 1; }
	set -- $wifs
	wdev=$1

	have iwctl || { tui_msgbox "Wireless" \
		"iwctl is not on this image. Use a wired connection instead."; return 1; }

	# iwd needs to be running before iwctl can talk to it.
	pgrep iwd >/dev/null 2>&1 || { iwd >/dev/null 2>&1 & sleep 2; }

	tui_clear; tui_header "Wireless" "$wdev"
	tui_at 4 4; printf '%sScanning...%s' "$c_ice" "$t_reset"
	iwctl station "$wdev" scan >/dev/null 2>&1
	sleep 3
	nets=$(iwctl station "$wdev" get-networks 2>/dev/null | \
		sed 's/\x1b\[[0-9;]*m//g' | awk 'NR>4 && NF>1 {print $1}' | grep -v '^-' | head -14)

	if [ -z "$nets" ]; then
		tui_msgbox "Wireless" "No networks were found. Move closer or use a cable."
		return 1
	fi
	# Each item is one argument, however many words are in it - "$@" is the
	# only array POSIX sh has. A string built with "items=\"$items x|y|z\""
	# and expanded unquoted word-splits on every space in the description,
	# turning "join this network" into three separate broken menu rows; that
	# bug is why this uses set -- instead.
	set --
	for n in $nets; do set -- "$@" "$n|$n|join this network"; done
	tui_menu "Choose a wireless network" "$wdev" "$@" || return 1
	ssid=$TUI_CHOICE
	tui_input "Wireless" "Passphrase for $ssid" "" hidden || return 1
	psk=$TUI_VALUE

	tui_clear; tui_header "Wireless" "connecting"
	tui_at 4 4; printf '%sJoining %s...%s' "$c_ice" "$ssid" "$t_reset"
	iwctl --passphrase "$psk" station "$wdev" connect "$ssid" >/dev/null 2>&1
	sleep 4
	udhcpc -i "$wdev" -n -q -s /usr/share/udhcpc/default.script >/dev/null 2>&1 \
		|| dhcpcd "$wdev" >/dev/null 2>&1
	if net_online; then
		A_NET="wifi"; A_WIFI_SSID=$ssid; A_WIFI_PSK=$psk; A_WIFI_IFACE=$wdev
		tui_msgbox "Wireless" "Connected to $ssid."
		return 0
	fi
	tui_msgbox "Wireless" "Could not join $ssid. Check the passphrase."
	return 1
}

# ------------------------------------------------------------------ disk setup

# Root filesystems Arctic can create, gated on the tool actually being on this
# image. Plain names only, no descriptions: a description with a space in it
# used to break this exact menu (see the set -- note in screen_wifi above) -
# removing them here sidesteps that entirely rather than relying on every
# future edit remembering to quote correctly.
screen_filesystem() {
	target=$1
	set --
	have mkfs.ext4  && set -- "$@" "ext4|ext4"
	have mkfs.btrfs && set -- "$@" "btrfs|btrfs"
	have mkfs.xfs   && set -- "$@" "xfs|xfs"
	have mkfs.f2fs  && set -- "$@" "f2fs|f2fs"
	have mkfs.ext3  && set -- "$@" "ext3|ext3"
	have mkfs.ext2  && set -- "$@" "ext2|ext2"
	have zpool      && set -- "$@" "zfs|zfs"
	[ "$#" -gt 0 ] || { tui_msgbox "Filesystem" "No mkfs tools are available."; return 1; }

	tui_menu "Root filesystem" "for $target" "$@" || return 1
	A_FS=$TUI_CHOICE

	[ "$A_FS" = btrfs ] || return 0

	# btrfs is the only one here that can snapshot, so the question only makes
	# sense for it.
	tui_menu "Snapshots" "btrfs" \
		"timeshift|Timeshift|Snapshot before every package change. The default." \
		"snapper|Snapper|Same, in snapper's /.snapshots layout" \
		"none|No snapshots|Plain subvolumes, nothing automatic" \
	|| return 1
	A_SNAPSHOT=$TUI_CHOICE
	return 0
}

# Make the filesystem chosen above, and lay out btrfs subvolumes when asked.
make_root_fs() {
	dev=$1
	case "$A_FS" in
	btrfs)
		mkfs.btrfs -f -L arctic-root "$dev" >>"$LOGF" 2>&1 || return 1
		# The @ / @home layout is what both timeshift and snapper expect: the
		# root subvolume can then be rolled back without taking home with it.
		mount "$dev" "$TARGET" >>"$LOGF" 2>&1 || return 1
		btrfs subvolume create "$TARGET/@"          >>"$LOGF" 2>&1 || return 1
		btrfs subvolume create "$TARGET/@home"      >>"$LOGF" 2>&1 || return 1
		btrfs subvolume create "$TARGET/@snapshots" >>"$LOGF" 2>&1 || return 1
		btrfs subvolume create "$TARGET/@log"       >>"$LOGF" 2>&1 || :
		umount "$TARGET" >>"$LOGF" 2>&1 || return 1

		A_BTRFS_OPTS="rw,noatime,compress=zstd:3,space_cache=v2"
		mount -o "$A_BTRFS_OPTS,subvol=@" "$dev" "$TARGET" >>"$LOGF" 2>&1 || return 1
		mkdir -p "$TARGET/home" "$TARGET/.snapshots" "$TARGET/var/log"
		mount -o "$A_BTRFS_OPTS,subvol=@home"      "$dev" "$TARGET/home"      >>"$LOGF" 2>&1 || :
		mount -o "$A_BTRFS_OPTS,subvol=@snapshots" "$dev" "$TARGET/.snapshots" >>"$LOGF" 2>&1 || :
		mount -o "$A_BTRFS_OPTS,subvol=@log"       "$dev" "$TARGET/var/log"   >>"$LOGF" 2>&1 || :
		;;
	xfs)  mkfs.xfs -f -L arctic-root "$dev" >>"$LOGF" 2>&1 || return 1
	      mount "$dev" "$TARGET" >>"$LOGF" 2>&1 || return 1 ;;
	f2fs) mkfs.f2fs -f -l arctic-root "$dev" >>"$LOGF" 2>&1 || return 1
	      mount "$dev" "$TARGET" >>"$LOGF" 2>&1 || return 1 ;;
	ext3) mkfs.ext3 -q -F -L arctic-root "$dev" >>"$LOGF" 2>&1 || return 1
	      mount "$dev" "$TARGET" >>"$LOGF" 2>&1 || return 1 ;;
	ext2) mkfs.ext2 -q -F -L arctic-root "$dev" >>"$LOGF" 2>&1 || return 1
	      mount "$dev" "$TARGET" >>"$LOGF" 2>&1 || return 1 ;;
	zfs)
		# Best-effort: Arctic has no zfs-utils package yet (OpenZFS needs an
		# out-of-tree kernel module - a DKMS-sized project of its own, not a
		# menu entry), so this path is untested end to end. It only runs at
		# all if `have zpool` found real tools on this image.
		zpool create -f -O mountpoint=none -O compression=zstd \
			-O acltype=posixacl -O xattr=sa -o cachefile=none \
			arctic-root "$dev" >>"$LOGF" 2>&1 || return 1
		zfs create -o mountpoint=legacy arctic-root/root >>"$LOGF" 2>&1 || return 1
		mount -t zfs arctic-root/root "$TARGET" >>"$LOGF" 2>&1 || return 1
		;;
	*)    mkfs.ext4 -q -F -L arctic-root "$dev" >>"$LOGF" 2>&1 || return 1
	      mount "$dev" "$TARGET" >>"$LOGF" 2>&1 || return 1 ;;
	esac
	return 0
}

list_disks() {
	for d in /sys/block/*; do
		n=$(basename "$d")
		case "$n" in loop*|ram*|sr*|dm-*|md*|zram*) continue ;; esac
		[ -r "$d/size" ] || continue
		sz=$(cat "$d/size" 2>/dev/null)
		[ "${sz:-0}" -gt 0 ] || continue
		bytes=$((sz * 512))
		model=$(cat "$d/device/model" 2>/dev/null | sed 's/[[:space:]]*$//')
		printf '%s|%s|%s\n' "$n" "$(human $bytes)" "${model:-disk}"
	done
}

# Partition names differ between /dev/sda1 and /dev/nvme0n1p1.
part_name() {
	case "$1" in
	*[0-9]) printf '%sp%s' "$1" "$2" ;;
	*)      printf '%s%s' "$1" "$2" ;;
	esac
}

screen_disk() {
	while :; do
		set --
		while IFS='|' read -r n sz model; do
			[ -n "$n" ] || continue
			set -- "$@" "${n}|/dev/${n}|$sz  $model"
		done <<-EOF
		$(list_disks)
		EOF
		set -- "$@" "manual|Do it myself|Drop to a shell with cfdisk, then come back"

		tui_menu "Disk" "step 1 of 10 - where should Arctic go?" "$@" || return 1

		if [ "$TUI_CHOICE" = manual ]; then
			tui_done
			printf '\n  Partition and format the disk, then mount it on %s.\n\n' "$TARGET"
			printf '  Tools available:  cfdisk  sfdisk  fdisk  wipefs  lsblk\n'
			printf '                    mkfs.ext4  mkfs.vfat  mkswap\n\n'
			printf '  For a UEFI machine that usually means:\n'
			printf '      cfdisk /dev/sdX          # 512M EFI System, rest Linux filesystem\n'
			printf '      mkfs.vfat -F32 /dev/sdX1\n'
			printf '      mkfs.ext4 /dev/sdX2\n'
			printf '      mount /dev/sdX2 %s\n\n' "$TARGET"
			printf '  Type exit when you are done to return to the installer.\n\n'
			${SHELL:-/bin/sh} -l || :
			tui_init
			if mountpoint -q "$TARGET" 2>/dev/null; then
				A_DISK_READY=1
				return 0
			fi
			tui_msgbox "Disk" "Nothing is mounted on $TARGET yet."
			continue
		fi

		disk=/dev/$TUI_CHOICE
		fw=$(detect_firmware)
		tui_yesno "Erase $disk" \
			"This erases everything on $disk and creates a fresh $fw layout. Continue?" no \
			|| continue
		auto_partition "$disk" "$fw" && { A_DISK_READY=1; return 0; }
	done
}

# Lay down a GPT and format it. Deliberately simple: one EFI partition when the
# machine booted through UEFI, and one root filesystem taking the rest.
auto_partition() {
	disk=$1 fw=$2
	tui_clear; tui_header "Disk" "$disk"
	r=4
	say_step() { tui_at "$r" 4; tui_el; printf '%s:: %s%s' "$c_teal" "$1" "$t_reset"; r=$((r+1)); }

	say_step "wiping the old signatures"
	wipefs -a "$disk" >>"$LOGF" 2>&1 || :

	if [ "$fw" = efi ]; then
		say_step "writing a GPT with an EFI partition and a root partition"
		# sfdisk reads the whole layout on stdin, which avoids a pile of
		# interactive fdisk keystrokes.
		printf 'label: gpt\n,512M,U\n,,L\n' | sfdisk --quiet "$disk" >>"$LOGF" 2>&1 || {
			tui_msgbox "Disk" "Partitioning failed. See $LOGF."; return 1; }
		p1=$(part_name "$disk" 1); p2=$(part_name "$disk" 2)
		say_step "formatting $p1 as FAT32 (EFI)"
		mkfs.vfat -F32 -n ARCTIC_EFI "$p1" >>"$LOGF" 2>&1 || {
			tui_msgbox "Disk" "mkfs.vfat failed on $p1."; return 1; }
	else
		say_step "writing a GPT with a BIOS boot partition and a root partition"
		printf 'label: gpt\n,1M,21686148-6449-6E6F-744E-656564454649\n,,L\n' \
			| sfdisk --quiet "$disk" >>"$LOGF" 2>&1 || {
			tui_msgbox "Disk" "Partitioning failed. See $LOGF."; return 1; }
		p1=""; p2=$(part_name "$disk" 2)
	fi

	screen_filesystem "$p2" || return 1
	tui_clear; tui_header "Disk" "$disk"; r=4

	say_step "formatting $p2 as $A_FS"
	mkdir -p "$TARGET"
	make_root_fs "$p2" || {
		tui_msgbox "Disk" "Could not create the $A_FS filesystem on $p2. See $LOGF."
		return 1; }
	[ "$A_FS" = btrfs ] && say_step "created subvolumes @ @home @snapshots @log"

	if [ -n "${p1:-}" ]; then
		say_step "mounting $p1 on $TARGET/boot"
		mkdir -p "$TARGET/boot"
		mount "$p1" "$TARGET/boot" >>"$LOGF" 2>&1 || :
		A_ESP=$p1
	fi
	A_ROOTDEV=$p2
	sleep 1
	tui_msgbox "Disk" "$disk is ready and mounted on $TARGET."
	return 0
}

# ------------------------------------------------------------------- screens

screen_desktop() {
	tui_menu "Graphical environment" "step 2 of 9" \
		"none|Nothing|Console only. Add anything you like later with alpm." \
		"kde|KDE Plasma|Full Wayland desktop with SDDM" \
		"hyprland|Hyprland|Wayland compositor, tiling, animated" \
		"niri|niri|Scrollable-tiling Wayland compositor" \
		"dwl|dwl|Suckless dynamic Wayland compositor" \
		"xfce|Xfce|Light traditional desktop on X11" \
		"dwm|dwm|Suckless dynamic window manager on X11" \
		"dms|dms|Dynamic minimal session, Arctic's own tiny shell" \
	|| return 1
	A_DESKTOP=$TUI_CHOICE
	case "$A_DESKTOP" in
	kde|xfce) A_DM_DEFAULT=sddm ;;
	dwm) A_DM_DEFAULT=xdm ;;
	*) A_DM_DEFAULT=sddm ;;
	esac
	[ "$A_DESKTOP" = none ] && return 0
	tui_menu "Login manager" "for $A_DESKTOP" \
		"sddm|SDDM|Qt greeter, themed for Arctic, Wayland ready" \
		"xdm|XDM|Tiny classic X display manager" \
		"greetd|greetd|Minimal console greeter, tuidm front end" \
		"none|None|Log in on the console and start it yourself" \
	|| return 1
	A_DM=$TUI_CHOICE
	return 0
}

screen_kernel() {
	tui_menu "Kernel" "step 3 of 9" \
		"Arctic-base-kernel|Arctic-base-kernel|Full hardware support. The default." \
		"Arctic-libre-kernel|Arctic-libre-kernel|No blob loading, fully free" \
		"Arctic-small-kernel|Arctic-small-kernel|Monolithic and tiny, no modules, fast boot" \
		"Arctic-lts-kernel|Arctic-lts-kernel|Long-term support branch, slower moving" \
		"Arctic-rt-kernel|Arctic-rt-kernel|PREEMPT_RT, low and predictable latency" \
		"Arctic-hardened-kernel|Arctic-hardened-kernel|Extra hardening, some performance cost" \
	|| return 1
	A_KERNEL=$TUI_CHOICE
	return 0
}

screen_users() {
	tui_input "User account" "Username for the everyday account" "" || return 1
	[ -n "$TUI_VALUE" ] || { tui_msgbox "User" "A username is required."; return 1; }
	case "$TUI_VALUE" in
	root) tui_msgbox "User" "Pick something other than root."; return 1 ;;
	*[!a-z0-9_-]*) tui_msgbox "User" \
		"Use lowercase letters, digits, dash and underscore only."; return 1 ;;
	esac
	A_USER=$TUI_VALUE
	tui_password "User account" "Password for $A_USER" || return 1
	A_USERPASS=$TUI_VALUE
	tui_menu "Shell for $A_USER" "zsh is the Arctic default" \
		"/bin/zsh|zsh|The Arctic default, configured out of the box" \
		"/bin/sh|busybox ash|Small and quick" \
		"/bin/mksh|mksh|The MirBSD Korn shell" \
		"/bin/dash|dash|Debian Almquist shell, POSIX and minimal" \
		"/usr/bin/fish|fish|Friendly interactive shell" \
	|| return 1
	A_SHELL=$TUI_CHOICE
	return 0
}

screen_rootpass() {
	if tui_yesno "Root account" \
		"Set a root password? Answer no to lock root and use doas only." yes; then
		tui_password "Root account" "Password for root" || return 1
		A_ROOTPASS=$TUI_VALUE
	else
		A_ROOTPASS="!locked"
	fi
	return 0
}

screen_locale() {
	tui_menu "Locale" "step 6 of 9" \
		"en_US.UTF-8|en_US.UTF-8|English, United States" \
		"en_GB.UTF-8|en_GB.UTF-8|English, United Kingdom" \
		"de_DE.UTF-8|de_DE.UTF-8|German" \
		"fr_FR.UTF-8|fr_FR.UTF-8|French" \
		"es_ES.UTF-8|es_ES.UTF-8|Spanish" \
		"pt_BR.UTF-8|pt_BR.UTF-8|Portuguese, Brazil" \
		"ru_RU.UTF-8|ru_RU.UTF-8|Russian" \
		"ja_JP.UTF-8|ja_JP.UTF-8|Japanese" \
		"zh_CN.UTF-8|zh_CN.UTF-8|Chinese, simplified" \
		"other|Other...|Type a locale name yourself" \
	|| return 1
	if [ "$TUI_CHOICE" = other ]; then
		tui_input "Locale" "Locale name" "en_US.UTF-8" || return 1
		A_LOCALE=$TUI_VALUE
	else
		A_LOCALE=$TUI_CHOICE
	fi
	A_LANG=$A_LOCALE
	tui_menu "Console keymap" "keyboard layout" \
		"us|us|United States" "uk|uk|United Kingdom" "de|de|German" \
		"fr|fr|French" "es|es|Spanish" "dvorak|dvorak|Dvorak" \
		"colemak|colemak|Colemak" "other|Other...|Type it yourself" \
	|| return 1
	if [ "$TUI_CHOICE" = other ]; then
		tui_input "Keymap" "Keymap name" "us" || return 1
		A_KEYMAP=$TUI_VALUE
	else
		A_KEYMAP=$TUI_CHOICE
	fi
	return 0
}

screen_timezone() {
	# Region first, then city, so the list stays navigable.
	regions=$(list_timezones | cut -d/ -f1 | sort -u | head -12)
	set --
	for r in $regions; do set -- "$@" "$r|$r|"; done
	set -- "$@" "UTC|UTC|Coordinated Universal Time"
	tui_menu "Time zone - region" "step 7 of 9" "$@" || return 1
	if [ "$TUI_CHOICE" = UTC ]; then A_TZ=UTC; return 0; fi
	region=$TUI_CHOICE
	cities=$(list_timezones | grep "^$region/" | cut -d/ -f2- | sort | head -30)
	set --
	for c in $cities; do set -- "$@" "$region/$c|$c|"; done
	tui_menu "Time zone - $region" "pick a city" "$@" || return 1
	A_TZ=$TUI_CHOICE
	tui_yesno "Clock" "Keep the clock in sync over the network (NTP)?" yes \
		&& A_NTP=yes || A_NTP=no
	return 0
}

screen_swap() {
	tui_menu "Swap" "step 8 of 9" \
		"file|Swap file|A file on the root filesystem, easy to resize later" \
		"partition|Swap partition|Use an existing partition" \
		"zram|zram|Compressed swap in RAM, no disk writes" \
		"none|No swap|Skip swap entirely" \
	|| return 1
	A_SWAP=$TUI_CHOICE
	case "$A_SWAP" in
	file|zram)
		mem=$(awk '/MemTotal/{printf "%d", $2/1024/1024}' /proc/meminfo 2>/dev/null)
		sug="${mem:-4}G"
		tui_input "Swap" "Size for the swap $A_SWAP" "$sug" || return 1
		A_SWAPSIZE=$TUI_VALUE ;;
	partition)
		parts=$(blkid -o device 2>/dev/null | head -12)
		[ -n "$parts" ] || parts=$(ls /dev/sd?[0-9]* /dev/nvme?n?p[0-9]* /dev/vd?[0-9]* 2>/dev/null)
		set --
		for p in $parts; do
			t=$(blkid -s TYPE -o value "$p" 2>/dev/null)
			sz=$(blockdev --getsize64 "$p" 2>/dev/null)
			set -- "$@" "$p|$p|${t:-unknown} $(human ${sz:-0} 2>/dev/null)"
		done
		[ "$#" -gt 0 ] || { tui_msgbox "Swap" "No partitions were found."; return 1; }
		tui_menu "Swap partition" "this will be formatted" "$@" || return 1
		A_SWAPDEV=$TUI_CHOICE ;;
	esac
	return 0
}

screen_hardware() {
	g=$(detect_gpu)
	tui_menu "Graphics driver" "detected: $g" \
		"auto|Automatic ($g)|Install what this machine actually has" \
		"nvidia|NVIDIA proprietary|From the nonfree repo" \
		"nouveau|Nouveau|Free NVIDIA driver, from alt-nonfree" \
		"amd|AMD|Mesa RADV, amdgpu firmware" \
		"intel|Intel|Mesa ANV, intel media driver" \
		"generic|Generic|Modesetting and llvmpipe only" \
	|| return 1
	A_GPU=$TUI_CHOICE

	tui_checklist "Extra system options" "space toggles" \
		"audio|Audio|pipewire, wireplumber and the ALSA bridge|on" \
		"bluetooth|Bluetooth|bluez and its tools|off" \
		"ssh|SSH server|OpenSSH, started at boot|off" \
		"firewall|Firewall|nftables with a sane default policy|on" \
		"trim|SSD trim|Weekly fstrim on solid state disks|on" \
		"printing|Printing|cups and drivers|off" \
		"devtools|Developer tools|clang, lld, cmake, ninja, git, python|off" \
		"vscode|Visual Studio Code|The editor, from the extra repo|off" \
		"multilib|32-bit support|multilib libraries, for Steam and Wine|off" \
	|| return 1
	A_AUDIO=no; A_BLUETOOTH=no; A_SSH=no; A_FIREWALL=no; A_TRIM=no; A_EXTRA=""
	for s in $TUI_SELECTED; do
		case "$s" in
		audio) A_AUDIO=yes ;;
		bluetooth) A_BLUETOOTH=yes ;;
		ssh) A_SSH=yes ;;
		firewall) A_FIREWALL=yes ;;
		trim) A_TRIM=yes ;;
		printing) A_EXTRA="$A_EXTRA cups" ;;
		devtools) A_EXTRA="$A_EXTRA clang lld cmake ninja git python bmake" ;;
		vscode) A_EXTRA="$A_EXTRA vscode" ;;
		multilib) A_EXTRA="$A_EXTRA glibc-32 mesa-32" ;;
		esac
	done
	return 0
}

screen_hostname() {
	tui_input "Hostname" "Name for this machine on the network" "arctic" || return 1
	A_HOSTNAME=$TUI_VALUE
	return 0
}

# ------------------------------------------------------------------- review

screen_review() {
	while :; do
		tui_size; tui_clear
		tui_header "Review" "nothing has been written yet"
		left=4
		r=4
		row() {
			tui_at "$r" "$left"
			printf '%s%-20s%s %s%s%s' "$c_grey" "$1" "$t_reset" "$c_snow" "$2" "$t_reset"
			r=$((r+1))
		}
		tui_at "$r" "$left"
		printf '%sArctic Linux will be installed with these settings%s' "$c_ice$t_bold" "$t_reset"
		r=$((r+2))
		row "Target"        "$TARGET"
		row "Hostname"      "$A_HOSTNAME"
		row "Kernel"        "$A_KERNEL"
		row "Desktop"       "$A_DESKTOP${A_DM:+ + $A_DM}"
		row "User"          "${A_USER:-none} ($A_SHELL)"
		row "Root"          "$([ "$A_ROOTPASS" = '!locked' ] && echo 'locked, doas only' || echo 'password set')"
		row "Locale"        "$A_LOCALE  keymap $A_KEYMAP"
		row "Time zone"     "$A_TZ$([ "$A_NTP" = yes ] && echo ' (NTP on)')"
		row "Network"       "$A_NET${A_WIFI_SSID:+ ($A_WIFI_SSID)}"
		row "Filesystem"    "$A_FS$([ "$A_FS" = btrfs ] && printf ' (subvolumes, snapshots: %s)' "${A_SNAPSHOT:-none}")"
		row "Swap"          "$A_SWAP $([ "$A_SWAP" = partition ] && echo "$A_SWAPDEV" || echo "$A_SWAPSIZE")"
		row "Graphics"      "$A_GPU"
		row "Firmware"      "$(detect_firmware)"
		row "Options"       "$(printf 'audio=%s bt=%s ssh=%s fw=%s' "$A_AUDIO" "$A_BLUETOOTH" "$A_SSH" "$A_FIREWALL")"
		[ -n "$A_EXTRA" ] && row "Extra packages" "$A_EXTRA"
		r=$((r+1))
		tui_at "$r" "$left"
		printf '%sThe target filesystem will be written to. Existing files stay unless%s' "$c_amb" "$t_reset"
		tui_at $((r+1)) "$left"
		printf '%sthey collide with a package.%s' "$c_amb" "$t_reset"

		tui_footer "enter save   b back to the menu   esc quit"
		k=$(tui_key)
		case "$k" in
		enter) return 0 ;;
		b|B|esc) return 1 ;;
		ctrlc) tui_done; exit 130 ;;
		esac
	done
}

# Quote a value for safe use inside single quotes in a shell file. Needed
# because the answers below include free-typed text - passwords, wifi
# passphrases and SSIDs, a hand-typed locale/keymap/hostname - and any of
# those containing an apostrophe (a thoroughly ordinary thing to put in a
# password) would otherwise close the quote early and corrupt the rest of
# the file. A password with one silently truncated to empty and the file
# failed to source at all before this existed.
shq() { printf '%s' "$1" | sed "s/'/'\\\\''/g"; }

save_conf() {
	{
		printf '# arctic-strap answers, written by arctic-conf %s\n' \
			"$(date '+%Y-%m-%d %H:%M:%S')"
		printf "TARGET='%s'\n"       "$(shq "$TARGET")"
		printf "A_KERNEL='%s'\n"     "$(shq "$A_KERNEL")"
		printf "A_DESKTOP='%s'\n"    "$(shq "$A_DESKTOP")"
		printf "A_DM='%s'\n"         "$(shq "${A_DM:-none}")"
		printf "A_HOSTNAME='%s'\n"   "$(shq "$A_HOSTNAME")"
		printf "A_USER='%s'\n"       "$(shq "$A_USER")"
		printf "A_USERPASS='%s'\n"   "$(shq "$A_USERPASS")"
		printf "A_ROOTPASS='%s'\n"   "$(shq "$A_ROOTPASS")"
		printf "A_SHELL='%s'\n"      "$(shq "$A_SHELL")"
		printf "A_LOCALE='%s'\n"     "$(shq "$A_LOCALE")"
		printf "A_LANG='%s'\n"       "$(shq "$A_LANG")"
		printf "A_KEYMAP='%s'\n"     "$(shq "$A_KEYMAP")"
		printf "A_TZ='%s'\n"         "$(shq "$A_TZ")"
		printf "A_NTP='%s'\n"        "$(shq "$A_NTP")"
		printf "A_NET='%s'\n"        "$(shq "$A_NET")"
		printf "A_WIFI_SSID='%s'\n"  "$(shq "$A_WIFI_SSID")"
		printf "A_WIFI_PSK='%s'\n"   "$(shq "$A_WIFI_PSK")"
		printf "A_WIFI_IFACE='%s'\n" "$(shq "$A_WIFI_IFACE")"
		printf "A_FS='%s'\n"         "$(shq "$A_FS")"
		printf "A_SNAPSHOT='%s'\n"   "$(shq "$A_SNAPSHOT")"
		printf "A_BTRFS_OPTS='%s'\n" "$(shq "$A_BTRFS_OPTS")"
		printf "A_SWAP='%s'\n"       "$(shq "$A_SWAP")"
		printf "A_SWAPSIZE='%s'\n"   "$(shq "$A_SWAPSIZE")"
		printf "A_SWAPDEV='%s'\n"    "$(shq "$A_SWAPDEV")"
		printf "A_GPU='%s'\n"        "$(shq "$A_GPU")"
		printf "A_AUDIO='%s'\n"      "$(shq "$A_AUDIO")"
		printf "A_BLUETOOTH='%s'\n"  "$(shq "$A_BLUETOOTH")"
		printf "A_SSH='%s'\n"        "$(shq "$A_SSH")"
		printf "A_FIREWALL='%s'\n"   "$(shq "$A_FIREWALL")"
		printf "A_TRIM='%s'\n"       "$(shq "$A_TRIM")"
		printf "A_EXTRA='%s'\n"      "$(shq "$A_EXTRA")"
	} >"$CONF"
	chmod 600 "$CONF"
}

# ------------------------------------------------------------- the config menu

config_menu() {
	done_disk=""; done_net=""; done_de=""; done_k=""; done_u=""; done_r=""
	done_l=""; done_t=""; done_s=""; done_h=""; done_hw=""
	mark() { [ -n "$1" ] && printf 'done' || printf 'not set'; }
	while :; do
		tui_menu "Setup" "target $TARGET" \
			"disk|1. Disk|$(mark "$done_disk")  partition and mount the target" \
			"net|2. Network|$(mark "$done_net")  wired, wireless or offline" \
			"de|3. Desktop|$(mark "$done_de")  ${A_DESKTOP}" \
			"kern|4. Kernel|$(mark "$done_k")  ${A_KERNEL}" \
			"user|5. User account|$(mark "$done_u")  ${A_USER:-none}" \
			"root|6. Root password|$(mark "$done_r")" \
			"loc|7. Locale and keymap|$(mark "$done_l")  ${A_LOCALE} / ${A_KEYMAP}" \
			"tz|8. Time zone|$(mark "$done_t")  ${A_TZ}" \
			"swap|9. Swap|$(mark "$done_s")  ${A_SWAP}" \
			"host|10. Hostname|$(mark "$done_h")  ${A_HOSTNAME}" \
			"hw|11. Drivers and extras|$(mark "$done_hw")  ${A_GPU}" \
			"go|Save and finish|Review the settings, then write the answer file" \
			"quit|Quit|Leave without saving anything" \
		|| return 1
		case "$TUI_CHOICE" in
		disk) screen_disk      && done_disk=1 ;;
		net)  screen_network   && done_net=1 ;;
		de)   screen_desktop   && done_de=1 ;;
		kern) screen_kernel    && done_k=1 ;;
		user) screen_users     && done_u=1 ;;
		root) screen_rootpass  && done_r=1 ;;
		loc)  screen_locale    && done_l=1 ;;
		tz)   screen_timezone  && done_t=1 ;;
		swap) screen_swap      && done_s=1 ;;
		host) screen_hostname  && done_h=1 ;;
		hw)   screen_hardware  && done_hw=1 ;;
		go)
			if ! mountpoint -q "$TARGET" 2>/dev/null; then
				tui_msgbox "Setup" \
					"Nothing is mounted on $TARGET. Do step 1 first, or mount it yourself."
				continue
			fi
			if [ -z "$A_USER" ]; then
				tui_msgbox "Setup" "Create a user account first (step 5)."
				continue
			fi
			if [ -z "$done_r" ]; then
				tui_msgbox "Setup" "Decide on the root password first (step 6)."
				continue
			fi
			screen_review && return 0 ;;
		quit)
			tui_yesno "Quit" "Leave arctic-conf? Nothing has been saved." no \
				&& return 1 ;;
		esac
	done
}

# ----------------------------------------------------------------------- main

need_root 2>/dev/null || { echo "Must be run as root." >&2; exit 1; }

OUTFILE="$CONF"
case "${1:-}" in
-h|--help|help)
	sed -n '2,13p' "$0" | sed 's/^# \?//'
	exit 0 ;;
--version)
	printf 'arctic-conf %s\n' "$VERSION"; exit 0 ;;
-o|--output)
	shift; OUTFILE=${1:?usage: arctic-conf -o file /mnt}; CONF=$OUTFILE; shift ;;
esac

[ -n "${1:-}" ] || { echo "usage: arctic-conf /mnt" >&2; exit 1; }
TARGET=$1
case "$TARGET" in
/*) ;;
*) TARGET="$(pwd)/$TARGET" ;;
esac
TARGET=$(printf '%s' "$TARGET" | sed 's|/*$||')
[ -d "$TARGET" ] || bail "$TARGET does not exist. Mount the target first, for example:
  mount /dev/nvme0n1p1 /mnt"

if detect_existing_install "$TARGET"; then
	printf '\n\033[38;5;215mThere is already an Arctic install on %s.\033[0m\n' "$TARGET"
	printf 'Continuing will overwrite files that belong to packages.\n\n'
	printf 'Continue? [y/N] '
	read -r a
	case "$a" in y|Y|yes) ;; *) echo "nothing was changed."; exit 0 ;; esac
fi

A_DM=""
A_TZ=$(cat /etc/timezone 2>/dev/null || echo UTC)
A_GPU=auto

tui_init
tui_splash "system configurator $VERSION"
sleep 1

if config_menu; then
	save_conf
	# Ask while the TUI is still active - tui_yesno needs the raw-mode,
	# alt-screen state tui_init set up, not the plain terminal tui_done
	# just restored.
	tui_yesno "Install now" "Run arctic-strap $TARGET now?" yes
	go=$?
	tui_done
	printf '\n  %sSaved to %s.%s\n\n' "$c_teal$t_bold" "$OUTFILE" "$t_reset"
	if [ "$go" = 0 ]; then
		exec arctic-strap -c "$OUTFILE" "$TARGET"
	fi
	printf '  Install with:\n\n'
	if [ "$OUTFILE" = "$CONF" ]; then
		printf '      %sarctic-strap %s%s\n\n' "$c_snow" "$TARGET" "$t_reset"
	else
		printf '      %sarctic-strap -c %s %s%s\n\n' "$c_snow" "$OUTFILE" "$TARGET" "$t_reset"
	fi
else
	tui_done
	printf 'nothing was saved.\n'
fi
